# Experiments: keep reproduction code and written conclusions, not generated
# traces, snapshots, large JSON dumps, reports or extensionless probe binaries.
# Reopen directories so the source/document exceptions below remain discoverable.
/artifacts/**
!/artifacts/**/
!/artifacts/**/*.md
!/artifacts/**/*.py
!/artifacts/**/*.sh
!/artifacts/**/*.tcl
!/artifacts/**/*.awk
!/artifacts/**/*.cpp
!/artifacts/**/*.cc
!/artifacts/**/*.h
!/artifacts/**/*.hpp

