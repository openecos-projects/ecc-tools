VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN imj_ecc_py ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 100000 100000 ) ;

ROW ROW0 CORE 0 0 N DO 10 BY 1 STEP 1000 0 ;
TRACKS Y 50000 DO 1 STEP 100000 LAYER M1 ;

COMPONENTS 1 ;
  - U_BLOCK BLOCK + PLACED ( 3000 0 ) N ;
END COMPONENTS

PINS 0 ;
END PINS

NETS 0 ;
END NETS

END DESIGN
