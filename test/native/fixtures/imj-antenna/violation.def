VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN imj_antenna_violation ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 52000 2000 ) ;

COMPONENTS 2 ;
  - U0 GATE + PLACED ( 0 0 ) N ;
  - U1 GATE + PLACED ( 50000 0 ) N ;
END COMPONENTS

PINS 0 ;
END PINS

NETS 1 ;
  - N_ANT ( U0 PINA ) ( U1 PINA ) + USE SIGNAL
    + ROUTED M1 ( 400 500 ) ( 50600 500 ) ;
END NETS

END DESIGN
