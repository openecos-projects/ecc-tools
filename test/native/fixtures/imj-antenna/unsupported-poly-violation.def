VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN imj_antenna_poly_violation ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 4000 2000 ) ;

COMPONENTS 1 ;
  - U0 POLYGATE + PLACED ( 0 0 ) N ;
END COMPONENTS

PINS 0 ;
END PINS

NETS 1 ;
  - N_POLY ( U0 PINA ) + USE SIGNAL ;
END NETS

END DESIGN
