VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN imj_antenna_patch_violation ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 4000 4000 ) ;

COMPONENTS 2 ;
  - U0 GATE + PLACED ( 0 0 ) N ;
  - U1 GATE + PLACED ( 2000 0 ) N ;
END COMPONENTS

PINS 0 ;
END PINS

NETS 1 ;
  - N_PATCH ( U0 PINA ) ( U1 PINA ) + USE SIGNAL
    + ROUTED M1 ( 400 500 ) ( 2600 500 )
      NEW M1 ( 400 500 ) RECT ( 0 0 2500 2000 ) ;
END NETS

END DESIGN
