# SPDX-License-Identifier: MulanPSL-2.0

VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 4000 1000 ) ;

COMPONENTS 1 ;
  - U0 BUF + PLACED ( 1000 0 ) N ;
END COMPONENTS

PINS 3 ;
  - IN + NET IN + DIRECTION INPUT + USE SIGNAL
    + LAYER M1 ( 0 400 ) ( 100 600 )
    + FIXED ( 0 0 ) N ;
  - BAD + NET BAD + DIRECTION INPUT + USE SIGNAL
    + LAYER M1 ( 0 400 ) ( 100 600 )
    + FIXED ( 0 200 ) N ;
  - OUT + NET OUT + DIRECTION OUTPUT + USE SIGNAL
    + LAYER M1 ( 0 400 ) ( 100 600 )
    + FIXED ( 3900 0 ) N ;
END PINS

NETS 4 ;
  - IN ( PIN IN ) ( U0 A ) + USE SIGNAL
    + ROUTED M1 ( 50 500 ) ( 1050 500 ) ;
  - BAD ( PIN BAD ) + USE SIGNAL ;
  - net16 ( U0 Y ) + USE SIGNAL ;
  - OUT ( PIN OUT ) + USE SIGNAL ;
END NETS

END DESIGN
