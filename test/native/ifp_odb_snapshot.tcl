#
# Read one iFP DEF through OpenDB and write a comparison-oriented TSV snapshot.
#
# Required environment:
#   ECC_IFP_LEFS     newline-separated LEF paths, in normal read order
#   ECC_IFP_DEF      DEF to inspect
#   ECC_IFP_SNAPSHOT TSV output path
#
# This script deliberately does not call any iFP, CTS, routing, or DEF-writing
# command.  It is an independent physical-view probe for a completed iFP
# output.  Every row has a kind in column zero; fields following the kind are
# kind-specific.  The Python companion compares each kind as a multiset, so
# OpenDB iteration order is not evidence of a backend difference.

proc ifp_snapshot_require_env {name} {
  if {![info exists ::env($name)] || $::env($name) eq ""} {
    error "missing required environment variable $name"
  }
  return $::env($name)
}

proc ifp_snapshot_field {value} {
  # DEF identifiers normally cannot contain a literal tab or newline.  Keep
  # every ordinary character, especially backslashes in escaped identifiers,
  # unchanged while making the TSV framing unambiguous for pathological names.
  return [string map [list "\t" "\\t" "\n" "\\n" "\r" "\\r"] $value]
}

proc ifp_snapshot_emit {stream args} {
  set fields {}
  foreach field $args {
    lappend fields [ifp_snapshot_field $field]
  }
  puts $stream [join $fields "\t"]
}

set lef_text [ifp_snapshot_require_env ECC_IFP_LEFS]
set input_def [ifp_snapshot_require_env ECC_IFP_DEF]
set output_tsv [ifp_snapshot_require_env ECC_IFP_SNAPSHOT]

foreach lef [split $lef_text "\n"] {
  set lef [string trim $lef]
  if {$lef eq ""} {
    continue
  }
  if {![file isfile $lef]} {
    error "LEF does not exist: $lef"
  }
  read_lef $lef
}
if {![file isfile $input_def]} {
  error "DEF does not exist: $input_def"
}
read_def $input_def

set stream [open $output_tsv w]
set block [ord::get_db_block]
if {$block eq "NULL"} {
  close $stream
  error "OpenDB did not create a block for $input_def"
}

# Component placement and the raw, master-relative halo.  Raw halo values are
# what DEF COMPONENT + HALO stores; orientation is emitted independently.
foreach inst [$block getInsts] {
  lassign [$inst getOrigin] x y
  set halo [$inst getHalo]
  if {$halo eq "NULL"} {
    set halo_fields [list "" "" "" "" ""]
  } else {
    set halo_fields [list [$halo xMin] [$halo yMin] [$halo xMax] [$halo yMax] [$halo isSoft]]
  }
  ifp_snapshot_emit $stream COMPONENT \
      [$inst getName] [[$inst getMaster] getName] $x $y \
      [$inst getOrient] [$inst getPlacementStatus] {*}$halo_fields
}

# A BTerm is logical; its dbBPin children own placement status and actual
# physical rectangles.  Emit the pin ordinal to distinguish multiple PORTs.
foreach term [$block getBTerms] {
  set net [$term getNet]
  set net_name ""
  if {$net ne "NULL"} {
    set net_name [$net getName]
  }
  set ordinal 0
  set bpins [$term getBPins]
  if {[llength $bpins] == 0} {
    ifp_snapshot_emit $stream BTERM [$term getName] $net_name -1 NONE
  }
  foreach bpin $bpins {
    set status [$bpin getPlacementStatus]
    ifp_snapshot_emit $stream BTERM [$term getName] $net_name $ordinal $status
    foreach box [$bpin getBoxes] {
      ifp_snapshot_emit $stream IOBOX \
          [$term getName] $ordinal $status [[$box getTechLayer] getName] \
          [$box xMin] [$box yMin] [$box xMax] [$box yMax]
    }
    incr ordinal
  }
}

# Special-net SBoxes are the physical PG geometry.  Do not emit the SWire or
# via-definition name: both are serialization/implementation detail and can
# differ despite identical physical geometry.  Net name remains necessary to
# keep VDD/VSS geometry from being silently conflated.
foreach net [$block getNets] {
  if {![$net isSpecial]} {
    continue
  }
  set net_name [$net getName]
  foreach swire [$net getSWires] {
    foreach box [$swire getWires] {
      if {[$box isVia]} {
        lassign [$box getViaXY] x y
        ifp_snapshot_emit $stream PGVIA $net_name $x $y
        # This materializes bottom/cut/top geometry at the via location.
        foreach via_box [$box getViaBoxes 0] {
          ifp_snapshot_emit $stream PGVIABOX \
              $net_name [[$via_box getTechLayer] getName] \
              [$via_box xMin] [$via_box yMin] [$via_box xMax] [$via_box yMax]
        }
      } else {
        ifp_snapshot_emit $stream PGSEGMENT \
            $net_name [[$box getTechLayer] getName] [$box getWireShapeType] \
            [$box xMin] [$box yMin] [$box xMax] [$box yMax]
      }
    }
  }
}

# TRACKS are not generated by every iFP path, but OpenDB exposes the physical
# grid when present.  Keep X/Y patterns separately and omit no data merely
# because a layer has more than one pattern.
foreach grid [$block getTrackGrids] {
  set layer [[$grid getTechLayer] getName]
  for {set index 0} {$index < [$grid getNumGridPatternsX]} {incr index} {
    lassign [$grid getGridPatternX $index] origin count step
    ifp_snapshot_emit $stream TRACK $layer X $origin $count $step
  }
  for {set index 0} {$index < [$grid getNumGridPatternsY]} {incr index} {
    lassign [$grid getGridPatternY $index] origin count step
    ifp_snapshot_emit $stream TRACK $layer Y $origin $count $step
  }
}

close $stream
exit 0
