file(READ "${HEADER}" contents)
string(REGEX MATCHALL "eccdb_[a-z_]+\\(" declarations "${contents}")
execute_process(COMMAND "${NM}" -D --defined-only "${LIBRARY}"
  RESULT_VARIABLE result OUTPUT_VARIABLE symbols)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect C ABI exports")
endif()
foreach(declaration IN LISTS declarations)
  string(REPLACE "(" "" name "${declaration}")
  if(NOT symbols MATCHES "[ \t]${name}\n")
    message(FATAL_ERROR "Missing C ABI export: ${name}")
  endif()
endforeach()
