+  return static_cast<uint64_t>(id.packed());
+}
+
+// frPin stores candidate groups in a dense vector and uses the vector index
+// as the group identifier. EccDB deliberately permits sparse group indices,
+// so importing one as empty DRT groups would change selection semantics.
+void requireDenseCandidateGroups(std::span<const DesignPinAccessCandidateGroup> groups,
+                                 std::string_view owner)
+{
+  if (groups.size() > static_cast<std::size_t>(std::numeric_limits<int>::max())) {
+    throw std::overflow_error("EccDB pin-access group count exceeds DRT range for " + std::string(owner));
+  }
+
+  std::vector<bool> seen(groups.size(), false);
+  for (const auto& group : groups) {
+    if (group.group_index >= groups.size() || seen[group.group_index]) {
+      throw std::invalid_argument("DRT cannot represent sparse or duplicate EccDB pin-access groups for "
+                                  + std::string(owner));
+    }
+    seen[group.group_index] = true;
+  }
+}
+
+[[nodiscard]] frLayer* requireFrLayer(const PhysicalDesignService& physical,
+                                       frDesign& route_design,
+                                       TechRoutingLayerId id)
+{
+  const auto& name = physical.layerInfo(eccdb::TechLayerId{id.entity()}).name;
+  auto* layer = route_design.getTech()->getLayer(name);
+  if (layer == nullptr) {
+    throw std::runtime_error("DRT has no routing layer named " + name);
+  }
+  return layer;
+}
+
+[[nodiscard]] TechRoutingLayerId requireEccdbRoutingLayer(const PhysicalDesignService& physical,
+                                                           const eccdb::TechStore& technology,
+                                                           const frLayer* layer)
+{
+  if (layer == nullptr) {
+    throw std::invalid_argument("DRT route context has no layer");
+  }
+  const auto id = technology.findLayer(layer->getName());
+  if (!id || physical.layerKind(id) != GeometryLayerKind::kRouting) {
+    throw std::runtime_error("EccDB has no routing layer named " + layer->getName());
+  }
+  return TechRoutingLayerId{id.entity()};
+}
+
+[[nodiscard]] frAccessPointEnum toFrAccessType(DesignPinAccessType value)
+{
+  switch (value) {
+    case DesignPinAccessType::kOnGrid:
+      return frAccessPointEnum::OnGrid;
+    case DesignPinAccessType::kHalfGrid:
+      return frAccessPointEnum::HalfGrid;
+    case DesignPinAccessType::kCenter:
+      return frAccessPointEnum::Center;
+    case DesignPinAccessType::kEncOpt:
+      return frAccessPointEnum::EncOpt;
+    case DesignPinAccessType::kNearbyGrid:
+      return frAccessPointEnum::NearbyGrid;
+  }
+  throw std::invalid_argument("EccDB pin-access type is invalid");
+}
+
+[[nodiscard]] DesignPinAccessType toEccdbAccessType(frAccessPointEnum value)
+{
+  switch (value) {
+    case frAccessPointEnum::OnGrid:
+      return DesignPinAccessType::kOnGrid;
+    case frAccessPointEnum::HalfGrid:
+      return DesignPinAccessType::kHalfGrid;
+    case frAccessPointEnum::Center:
+      return DesignPinAccessType::kCenter;
+    case frAccessPointEnum::EncOpt:
+      return DesignPinAccessType::kEncOpt;
+    case frAccessPointEnum::NearbyGrid:
+      return DesignPinAccessType::kNearbyGrid;
+  }
+  throw std::invalid_argument("DRT pin-access type is invalid");
+}
+
+void setFrDirections(frAccessPoint& access_point, uint32_t directions)
+{
+  using namespace eccdb::DesignPinAccessDirection;
+  access_point.setAccess(frDirEnum::N, (directions & kNorth) != 0u);
+  access_point.setAccess(frDirEnum::E, (directions & kEast) != 0u);
+  access_point.setAccess(frDirEnum::S, (directions & kSouth) != 0u);
+  access_point.setAccess(frDirEnum::W, (directions & kWest) != 0u);
+  access_point.setAccess(frDirEnum::U, (directions & kUp) != 0u);
+  access_point.setAccess(frDirEnum::D, (directions & kDown) != 0u);
+}
+
+[[nodiscard]] uint32_t toEccdbDirections(const frAccessPoint& access_point)
+{
+  using namespace eccdb::DesignPinAccessDirection;
+  uint32_t result = 0;
+  if (access_point.hasAccess(frDirEnum::N)) {
+    result |= kNorth;
+  }
+  if (access_point.hasAccess(frDirEnum::E)) {
+    result |= kEast;
+  }
+  if (access_point.hasAccess(frDirEnum::S)) {
+    result |= kSouth;
+  }
+  if (access_point.hasAccess(frDirEnum::W)) {
+    result |= kWest;
+  }
+  if (access_point.hasAccess(frDirEnum::U)) {
+    result |= kUp;
+  }
+  if (access_point.hasAccess(frDirEnum::D)) {
+    result |= kDown;
+  }
+  return result;
+}
+
+struct ViaLookup
+{
+  std::unordered_map<uint64_t, std::string> tech_names;
+  std::unordered_map<uint64_t, std::string> design_names;
+  std::unordered_map<std::string, eccdb::TechViaMasterId> tech_ids;
+  std::unordered_map<std::string, eccdb::DesignViaId> design_ids;
+};
+
+[[nodiscard]] ViaLookup buildViaLookup(const PhysicalDesignService& physical)
+{
+  ViaLookup result;
+  physical.forEachTechVia([&](auto id, const auto& via, const auto&) {
+    if (via.name.empty() || result.design_ids.contains(via.name) || !result.tech_ids.emplace(via.name, id).second) {
+      throw std::invalid_argument("EccDB pin-access VIAs must have globally unique non-empty names");
+    }
+    result.tech_names.emplace(packed(id), via.name);
+  });
+  physical.forEachDesignVia([&](auto id, const auto& via) {
+    if (via.name.empty() || result.tech_ids.contains(via.name) || !result.design_ids.emplace(via.name, id).second) {
+      throw std::invalid_argument("EccDB pin-access VIAs must have globally unique non-empty names");
+    }
+    result.design_names.emplace(packed(id), via.name);
+  });
+  return result;
+}
+
+[[nodiscard]] const std::string& viaName(const ViaLookup& lookup, const DesignPinAccessVia& via)
+{
+  if (static_cast<bool>(via.tech_via) == static_cast<bool>(via.design_via)) {
+    throw std::invalid_argument("EccDB pin-access VIA must reference exactly one VIA definition");
+  }
+  if (via.tech_via) {
+    const auto found = lookup.tech_names.find(packed(via.tech_via));
+    if (found != lookup.tech_names.end()) {
+      return found->second;
+    }
+  }
+  if (via.design_via) {
+    const auto found = lookup.design_names.find(packed(via.design_via));
+    if (found != lookup.design_names.end()) {
+      return found->second;
+    }
+  }
+  throw std::runtime_error("EccDB pin-access VIA is absent from the physical design");
+}
+
+[[nodiscard]] std::unique_ptr<frAccessPoint> toFrAccessPoint(const DesignPinAccessPoint& point,
+                                                               const PhysicalDesignService& physical,
+                                                               frDesign& route_design,
+                                                               const ViaLookup& vias)
+{
+  auto* layer = requireFrLayer(physical, route_design, point.layer);
+  auto result = std::make_unique<frAccessPoint>(toOdb(point.point), layer->getLayerNum());
+  setFrDirections(*result, point.access_directions);
+  result->setType(toFrAccessType(point.low_type), true);
+  result->setType(toFrAccessType(point.high_type), false);
+
+  for (const auto& via : point.vias) {
+    const auto* via_def = route_design.getTech()->getVia(viaName(vias, via));
+    if (via_def == nullptr) {
+      throw std::runtime_error("DRT does not know EccDB pin-access VIA " + viaName(vias, via));
+    }
+    if (via.cut_count != static_cast<uint32_t>(via_def->getNumCut())) {
+      throw std::invalid_argument("EccDB pin-access VIA cut-count does not match DRT VIA definition");
+    }
+    result->addViaDef(via_def);
+  }
+
+  for (const auto& segment : point.path_segments) {
+    frPathSeg path;
+    const auto rectangle = toOdb(segment.rectangle);
+    path.setPoints_safe(rectangle.ll(), rectangle.ur());
+    if ((segment.flags & kBeginTruncated) != 0u) {
+      path.setBeginStyle(frcTruncateEndStyle);
+    }
+    if ((segment.flags & kEndTruncated) != 0u) {
+      path.setEndStyle(frcTruncateEndStyle);
+    }
+    result->addPathSeg(path);
+  }
+  return result;
+}
+
+[[nodiscard]] DesignPinAccessPoint toEccdbAccessPoint(const frAccessPoint& access_point,
+                                                       const PhysicalDesignService& physical,
+                                                       const eccdb::TechStore& technology,
+                                                       const frDesign& route_design,
+                                                       const ViaLookup& vias)
+{
+  DesignPinAccessPoint result;
+  result.point = toEccdb(access_point.getPoint());
+  result.layer = requireEccdbRoutingLayer(
+      physical, technology, route_design.getTech()->getLayer(access_point.getLayerNum()));
+  result.access_directions = toEccdbDirections(access_point);
+  result.low_type = toEccdbAccessType(access_point.getType(true));
+  result.high_type = toEccdbAccessType(access_point.getType(false));
+
+  const auto& via_buckets = access_point.getAllViaDefs();
+  for (std::size_t bucket_index = 0; bucket_index < via_buckets.size(); ++bucket_index) {
+    if (bucket_index >= std::numeric_limits<uint32_t>::max()) {
+      throw std::overflow_error("DRT pin-access VIA cut-count exceeds EccDB range");
+    }
+    const auto cut_count = static_cast<uint32_t>(bucket_index + 1u);
+    for (const auto* via_def : via_buckets[bucket_index]) {
+      if (via_def == nullptr || via_def->getNumCut() != static_cast<int>(cut_count)) {
+        throw std::invalid_argument("DRT pin-access VIA bucket does not match its VIA definition");
+      }
+      const auto& name = via_def->getName();
+      DesignPinAccessVia via{.cut_count = cut_count, .tech_via = {}, .design_via = {}};
+      if (const auto tech_via = vias.tech_ids.find(name); tech_via != vias.tech_ids.end()) {
+        via.tech_via = tech_via->second;
+      } else if (const auto design_via = vias.design_ids.find(name); design_via != vias.design_ids.end()) {
+        via.design_via = design_via->second;
+      } else {
+        throw std::runtime_error("EccDB has no pin-access VIA named " + name);
+      }
+      result.vias.push_back(via);
+    }
+  }
+
+  // frAccessPoint predates const-correct access to path segments. This view
+  // is read-only here.
+  for (const auto& path : const_cast<frAccessPoint&>(access_point).getPathSegs()) {
+    uint32_t flags = 0;
+    if (path.getBeginStyle() == frcTruncateEndStyle) {
+      flags |= kBeginTruncated;
+    }
+    if (path.getEndStyle() == frcTruncateEndStyle) {
+      flags |= kEndTruncated;
+    }
+    result.path_segments.push_back(
+        DesignPinAccessPathSegment{.rectangle = toEccdb(odb::Rect(path.getBeginPoint(), path.getEndPoint())), .flags = flags});
+  }
+  return result;
+}
+
+// Visits DRT master PORTs in exactly the LEF PORT order used by EccDB. A
+// mismatch means the two designs cannot safely exchange pin-access state.
+template <typename Function>
+void forEachMasterPort(const PhysicalDesignService& physical, const frDesign& route_design, Function&& function)
+{
+  for (const auto& master_ptr : route_design.getMasters()) {
+    const auto& master = *master_ptr;
+    const auto master_id = physical.findMaster(master.getName());
+    if (!master_id) {
+      throw std::runtime_error("EccDB has no master named " + master.getName());
+    }
+    for (const auto& term_ptr : master.getTerms()) {
+      const auto& term = *term_ptr;
+      const auto term_id = physical.findMasterTerm(master_id, term.getName());
+      if (!term_id) {
+        throw std::runtime_error("EccDB has no master terminal " + master.getName() + "/" + term.getName());
+      }
+      const auto ports = physical.masterPorts(term_id);
+      if (ports.size() != term.getPins().size()) {
+        throw std::runtime_error("EccDB and DRT disagree on PORT count for " + master.getName() + "/" + term.getName());
+      }
+      for (std::size_t index = 0; index < ports.size(); ++index) {
+        function(master, term, *term.getPins()[index], ports[index], index);
+      }
+    }
+  }
+}
+
+struct CandidateReference
+{
+  LibraryMasterPortId master_port;
+  uint32_t group_index = 0;
+  uint32_t point_index = 0;
+};
+
+using CandidateReferenceMap = std::unordered_map<const frAccessPoint*, CandidateReference>;
+
+[[nodiscard]] uint32_t checkedGroupIndex(std::size_t index)
+{
+  if (index > std::numeric_limits<uint32_t>::max()) {
+    throw std::overflow_error("DRT pin-access group index exceeds EccDB range");
+  }
+  return static_cast<uint32_t>(index);
+}
+
+void addCandidateReferences(const frMPin& pin, LibraryMasterPortId master_port, CandidateReferenceMap& references)
+{
+  for (int group_index = 0; group_index < pin.getNumPinAccess(); ++group_index) {
+    const auto* group = pin.getPinAccess(group_index);
+    if (group == nullptr) {
+      throw std::logic_error("DRT pin-access group is unexpectedly null");
+    }
+    for (std::size_t point_index = 0; point_index < group->getAccessPoints().size(); ++point_index) {
+      const auto* point = group->getAccessPoints()[point_index].get();
+      references.emplace(point,
+                         CandidateReference{.master_port = master_port,
+                                            .group_index = checkedGroupIndex(static_cast<std::size_t>(group_index)),
+                                            .point_index = checkedGroupIndex(point_index)});
+    }
+  }
+}
+
+void requireEveryDrtRegularNetInEccdb(const PhysicalDesignService& physical, const frBlock& block)
+{
+  for (const auto& net_ptr : block.getNets()) {
+    const auto& net = *net_ptr;
+    if (net.isSpecial()) {
+      continue;
+    }
+    if (!physical.findRegularNet(net.getName())) {
+      throw std::runtime_error("EccDB has no regular net named " + net.getName());
+    }
+  }
+}
+
+[[nodiscard]] std::size_t ioPortCount(const PhysicalDesignService& physical, eccdb::DesignIoPinId pin)
+{
+  return physical.blockPins(eccdb::DesignBlockTermId{pin.entity()}).size();
+}
+
+void populateMasterPortCandidates(const eccdb::DesignPinAccessStorage& context,
+                                  const PhysicalDesignService& physical,
+                                  frDesign& route_design,
+                                  const ViaLookup& vias,
+                                  CandidateReferenceMap& references)
+{
+  forEachMasterPort(physical, route_design, [&](const frMaster&, const frMTerm&, const frMPin& pin,
+                                                 LibraryMasterPortId port, std::size_t) {
+    auto& mutable_pin = const_cast<frMPin&>(pin);
+    mutable_pin.clearPinAccess();
+    const auto groups = context.masterPortCandidateGroups(port);
+    if (groups.empty()) {
+      return;
+    }
+    requireDenseCandidateGroups(groups, "master port");
+    for (std::size_t index = 0; index < groups.size(); ++index) {
+      mutable_pin.addPinAccess(std::make_unique<frPinAccess>());
+    }
+    for (const auto& group : groups) {
+      auto replacement = std::make_unique<frPinAccess>();
+      for (const auto& point : group.points) {
+        replacement->addAccessPoint(toFrAccessPoint(point, physical, route_design, vias));
+      }
+      mutable_pin.setPinAccess(static_cast<int>(group.group_index), std::move(replacement));
+    }
+    addCandidateReferences(pin, port, references);
+  });
+}
+
+void populateIoPinCandidates(const eccdb::DesignPinAccessStorage& context,
+                             const PhysicalDesignService& physical,
+                             frDesign& route_design,
+                             const ViaLookup& vias)
+{
+  const auto* block = route_design.getTopBlock();
+  if (block == nullptr) {
+    throw std::logic_error("DRT design must be loaded before EccDB pin access");
+  }
+  for (const auto& term_ptr : block->getTerms()) {
+    const auto& term = *term_ptr;
+    const auto io_pin = physical.findIoPin(term.getName());
+    if (!io_pin) {
+      throw std::runtime_error("EccDB has no IO pin named " + term.getName());
+    }
+    if (ioPortCount(physical, io_pin) != term.getPins().size()) {
+      throw std::invalid_argument("EccDB and DRT disagree on IO pin PORT count for " + term.getName());
+    }
+    for (std::size_t port_index = 0; port_index < term.getPins().size(); ++port_index) {
+      auto& pin = *term.getPins()[port_index];
+      pin.clearPinAccess();
+      const auto groups = context.ioPinPortCandidateGroups(io_pin, checkedGroupIndex(port_index));
+      if (groups.empty()) {
+        continue;
+      }
+      requireDenseCandidateGroups(groups, "IO pin port");
+      for (std::size_t index = 0; index < groups.size(); ++index) {
+        pin.addPinAccess(std::make_unique<frPinAccess>());
+      }
+      for (const auto& group : groups) {
+        auto replacement = std::make_unique<frPinAccess>();
+        for (const auto& point : group.points) {
+          replacement->addAccessPoint(toFrAccessPoint(point, physical, route_design, vias));
+        }
+        pin.setPinAccess(static_cast<int>(group.group_index), std::move(replacement));
+      }
+    }
+  }
+}
+
+void populateInstancePreferences(const eccdb::DesignPinAccessStorage& context,
+                                 const PhysicalDesignService& physical,
+                                 frDesign& route_design,
+                                 const CandidateReferenceMap& references)
+{
+  const auto* block = route_design.getTopBlock();
+  if (block == nullptr) {
+    throw std::logic_error("DRT design must be loaded before EccDB pin access");
+  }
+  for (const auto& inst_ptr : block->getInsts()) {
+    auto& instance = *inst_ptr;
+    const auto instance_id = physical.findInstance(instance.getName());
+    if (!instance_id) {
+      throw std::runtime_error("EccDB has no instance named " + instance.getName());
+    }
+    const auto selection = context.instancePinAccessGroup(instance_id);
+    if (selection.has_value()) {
+      if (*selection > static_cast<uint32_t>(std::numeric_limits<int>::max())) {
+        throw std::overflow_error("EccDB instance pin-access group index exceeds DRT range");
+      }
+      instance.setPinAccessIdx(static_cast<int>(*selection));
+    } else {
+      instance.deletePinAccessIdx();
+    }
+    for (const auto& term_ptr : instance.getInstTerms()) {
+      auto& term = *term_ptr;
+      const auto pin_id = physical.findInstancePin(instance_id, term.getTerm()->getName());
+      if (!pin_id) {
+        throw std::runtime_error("EccDB has no instance pin " + instance.getName() + "/" + term.getTerm()->getName());
+      }
+      const auto port_count = term.getTerm()->getPins().size();
+      term.clearAccessPoints();
+      term.setAPSize(static_cast<int>(port_count));
+      const auto preferences = context.preferredInstancePinAccess(pin_id);
+      for (const auto& preference : preferences) {
+        bool assigned = false;
+        for (std::size_t port_index = 0; port_index < port_count; ++port_index) {
+          const auto& port = *term.getTerm()->getPins()[port_index];
+          if (preference.group_index > static_cast<uint32_t>(std::numeric_limits<int>::max())
+              || static_cast<int>(preference.group_index) >= port.getNumPinAccess()) {
+            continue;
+          }
+          const auto* group = port.getPinAccess(static_cast<int>(preference.group_index));
+          if (group == nullptr || preference.point_index >= group->getAccessPoints().size()) {
+            continue;
+          }
+          const auto* candidate = group->getAccessPoints()[preference.point_index].get();
+          const auto found = references.find(candidate);
+          if (found != references.end() && found->second.master_port == preference.master_port) {
+            term.setAccessPoint(static_cast<int>(port_index), const_cast<frAccessPoint*>(candidate));
+            assigned = true;
+            break;
+          }
+        }
+        if (!assigned) {
+          throw std::invalid_argument("EccDB preferred pin-access point cannot be represented by DRT");
+        }
+      }
+    }
+  }
+}
+
+}  // namespace
