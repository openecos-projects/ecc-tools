+TEST_F(EccdbAdapterTest, PinAccessRoundTripsCandidatesAndPreferredInstancePoint)
+{
+  const auto [drt_master, db_master] = makeMacro("MAC");
+  static_cast<void>(makeMacroPin(drt_master, "A", 0, 0, 10, 10));
+  auto* drt_instance = makeInst("u1", drt_master, db_master);
+  auto* drt_pin = drt_master->getTerm("A")->getPins().front().get();
+  auto* drt_instance_pin = drt_instance->getInstTerms().front().get();
+
+  eccdb::LibraryCellMaster master_record;
+  master_record.name = "MAC";
+  const auto master = library_.cellMasterStorage().createCellMaster(std::move(master_record));
+  eccdb::LibraryMasterTerm term_record;
+  term_record.name = "A";
+  term_record.direction = eccdb::LibraryMasterTermDirection::kInput;
+  const auto term = library_.masterTermStorage().createMasterTerm(master, std::move(term_record));
+  const auto port = library_.masterPortStorage().createMasterPort(term);
+
+  eccdb::DesignInstance instance_record;
+  instance_record.name = "u1";
+  instance_record.master = master;
+  instance_record.placement_status = eccdb::DesignPlacementStatus::kPlaced;
+  const auto instance = design_store_.netlistStorage().createInstance(std::move(instance_record));
+  const auto instance_pin = design_store_.netlistStorage().findInstancePin(instance, term);
+  ASSERT_TRUE(instance_pin);
+
+  eccdb::DatabaseContext database_context(technology_, library_, design_store_);
+  eccdb::RoutingService context(database_context);
+  eccdb::DesignPinAccessPoint candidate;
+  candidate.point = {10, 20};
+  candidate.layer = m1_;
+  candidate.access_directions = eccdb::DesignPinAccessDirection::kNorth | eccdb::DesignPinAccessDirection::kUp;
+  context.setMasterPortCandidateGroup(port, 0u, {candidate});
+  context.setInstancePinAccessGroup(instance, 0u);
+  eccdb::DesignPreferredPinAccessRef preference;
+  preference.master_port = port;
+  preference.group_index = 0u;
+  preference.point_index = 0u;
+  context.setPreferredInstancePinAccess(instance_pin, {preference});
+
+  io::EccdbContextAdapter adapter(context_, *design);
+  ASSERT_NO_THROW(adapter.readPinAccess());
+  ASSERT_EQ(drt_pin->getNumPinAccess(), 1);
+  ASSERT_EQ(drt_pin->getPinAccess(0)->getAccessPoints().size(), 1u);
+  auto* drt_candidate = drt_pin->getPinAccess(0)->getAccessPoint(0);
+  EXPECT_EQ(drt_candidate->getPoint(), (odb::Point{10, 20}));
+  EXPECT_EQ(drt_candidate->getLayerNum(), drtM1Layer());
+  EXPECT_TRUE(drt_candidate->hasAccess(frDirEnum::N));
+  EXPECT_TRUE(drt_candidate->hasAccess(frDirEnum::U));
+  EXPECT_EQ(drt_instance->getPinAccessIdx(), 0);
+  ASSERT_EQ(drt_instance_pin->getAccessPoints().size(), 1u);
+  EXPECT_EQ(drt_instance_pin->getAccessPoint(0), drt_candidate);
+
+  drt_candidate->setPoint({11, 21});
+  drt_candidate->setAccess(frDirEnum::E);
+  const auto revision = context_.revision();
+  ASSERT_NO_THROW(adapter.writePinAccess());
+  EXPECT_EQ(context_.revision(), revision + 1u);
+
+  const auto groups = context.masterPortCandidateGroups(port);
+  ASSERT_EQ(groups.size(), 1u);
+  EXPECT_EQ(groups.front().group_index, 0u);
+  ASSERT_EQ(groups.front().points.size(), 1u);
+  EXPECT_EQ(groups.front().points.front().point, (eccdb::Point{11, 21}));
+  EXPECT_EQ(groups.front().points.front().access_directions,
+            eccdb::DesignPinAccessDirection::kNorth | eccdb::DesignPinAccessDirection::kEast
+                | eccdb::DesignPinAccessDirection::kUp);
+  EXPECT_EQ(context.instancePinAccessGroup(instance), std::optional<uint32_t>{0u});
+  const auto preferences = context.preferredInstancePinAccess(instance_pin);
+  ASSERT_EQ(preferences.size(), 1u);
+  EXPECT_EQ(preferences.front().master_port, port);
+  EXPECT_EQ(preferences.front().group_index, 0u);
+  EXPECT_EQ(preferences.front().point_index, 0u);
+}
