+
+void EccdbContextAdapter::writeGuideStage(bool save_guides, bool save_assignments)
+{
+  auto& database_context = context_;
+  PhysicalDesignService physical(database_context);
+  RoutingService context(database_context);
+  const auto* block = route_design_.getTopBlock();
+  if (block == nullptr) {
+    throw std::logic_error("DRT design must be loaded before EccDB guide-stage output");
+  }
+  requireEveryDrtRegularNetInEccdb(physical, *block);
+  physical.forEachRegularNet([&](const auto net_id, const auto& design_net) {
+    auto* net = block->findNet(design_net.name);
+    if (net == nullptr || net->isSpecial()) {
+      throw std::runtime_error("DRT has no regular net named " + design_net.name);
+    }
+    std::optional<std::vector<eccdb::DesignRouteGuide>> guides;
+    if (save_guides) {
+      guides.emplace();
+      guides->reserve(net->getGuides().size());
+    }
+    std::vector<DesignTrackAssignmentShape> assignments;
+    for (const auto& guide : net->getGuides()) {
+      if (guides) {
+        auto box = guide->getBBox();
+        if (block->getGCellPatterns().size() >= 2u) {
+          const auto [begin, end] = guide->getPoints();
+          const auto begin_box = block->getGCellBox(block->getGCellIdx(begin));
+          const auto end_box = block->getGCellBox(block->getGCellIdx(end));
+          box = {begin_box.xMin(), begin_box.yMin(), end_box.xMax(), end_box.yMax()};
+        }
+        const auto* layer = route_design_.getTech()->getLayer(guide->getLayerNum());
+        const auto layer_id = requireEccdbRoutingLayer(physical, technology_, layer);
+        guides->push_back({.box = toEccdb(box), .layer = layer_id, .via_layer = layer_id, .flags = 0u});
+      }
+      if (!save_assignments) continue;
+      for (const auto& route : guide->getRoutes()) {
+        if (route->typeId() != frcPathSeg) {
+          throw std::invalid_argument("DRT guide route is not a track-assignment path segment");
+        }
+        const auto& track = static_cast<const frPathSeg&>(*route);
+        assignments.push_back({.layer = requireEccdbRoutingLayer(
+                                   physical, technology_, route_design_.getTech()->getLayer(track.getLayerNum())),
+                               .box = toEccdb(track.getBBox())});
+      }
+    }
+    context.replaceGuideStage(net_id, std::move(guides), std::move(assignments));
+  });
+}
+
+void EccdbContextAdapter::writePinAccess()
+{
+  // Project the complete scoped stage before replacing any selected group.
+  auto& database_context = context_;
+  PhysicalDesignService physical(database_context);
+  RoutingService context(database_context);
+  const auto vias = buildViaLookup(physical);
+  const auto* block = route_design_.getTopBlock();
+  if (block == nullptr) {
+    throw std::logic_error("DRT design must be loaded before EccDB pin-access output");
+  }
+
+  const auto project_groups = [&](const auto& pin) {
+    std::vector<DesignPinAccessCandidateGroup> groups;
+    groups.reserve(pin.getNumPinAccess());
+    for (int index = 0; index < pin.getNumPinAccess(); ++index) {
+      const auto* group = pin.getPinAccess(index);
+      std::vector<DesignPinAccessPoint> points;
+      points.reserve(group->getAccessPoints().size());
+      for (const auto& point : group->getAccessPoints()) {
+        points.push_back(toEccdbAccessPoint(*point, physical, technology_, route_design_, vias));
+      }
+      groups.push_back({.group_index = checkedGroupIndex(static_cast<std::size_t>(index)), .points = std::move(points)});
+    }
+    return groups;
+  };
+  eccdb::DesignPinAccessUpdate update;
+  CandidateReferenceMap references;
+  forEachMasterPort(physical, route_design_, [&](const frMaster&, const frMTerm&, const frMPin& pin,
+                                                 LibraryMasterPortId port, std::size_t) {
+    auto& output = update.master_ports.emplace_back();
+    output.master_port = port;
+    output.groups = project_groups(pin);
+    addCandidateReferences(pin, port, references);
+  });
+
+  for (const auto& term_ptr : block->getTerms()) {
+    const auto& term = *term_ptr;
+    const auto io_pin = physical.findIoPin(term.getName());
+    if (!io_pin) {
+      throw std::runtime_error("EccDB has no IO pin named " + term.getName());
+    }
+    if (ioPortCount(physical, io_pin) != term.getPins().size()) {
+      throw std::invalid_argument("EccDB and DRT disagree on IO pin PORT count for " + term.getName());
+    }
+    for (std::size_t port_index = 0; port_index < term.getPins().size(); ++port_index) {
+      const auto& pin = *term.getPins()[port_index];
+      auto& output = update.block_pins.emplace_back();
+      output.pin = physical.blockPins(eccdb::DesignBlockTermId{io_pin.entity()})[port_index];
+      output.candidates.groups = project_groups(pin);
+    }
+  }
+
+  for (const auto& inst_ptr : block->getInsts()) {
+    const auto& instance = *inst_ptr;
+    const auto instance_id = physical.findInstance(instance.getName());
+    if (!instance_id) {
+      throw std::runtime_error("EccDB has no instance named " + instance.getName());
+    }
+    auto& output = update.instances.emplace_back();
+    output.instance = instance_id;
+    if (instance.getPinAccessIdx() != -1) {
+      output.group_index = checkedGroupIndex(static_cast<std::size_t>(instance.getPinAccessIdx()));
+    }
+    for (const auto& term_ptr : instance.getInstTerms()) {
+      const auto pin_id = physical.findInstancePin(instance_id, term_ptr->getTerm()->getName());
+      if (!pin_id) {
+        throw std::runtime_error("EccDB has no instance pin " + instance.getName() + "/" + term_ptr->getTerm()->getName());
+      }
+      std::vector<DesignPreferredPinAccessRef> preferences;
+      for (const auto* access_point : term_ptr->getAccessPoints()) {
+        if (access_point == nullptr) {
+          continue;
+        }
+        const auto found = references.find(access_point);
+        if (found == references.end()) {
+          throw std::invalid_argument("DRT preferred access point is not owned by an EccDB master-port candidate");
+        }
+        preferences.push_back({.master_port = found->second.master_port,
+                               .group_index = found->second.group_index,
+                               .point_index = found->second.point_index});
+      }
+      if (!preferences.empty()) output.preferences.entries.push_back({.pin = pin_id, .values = std::move(preferences)});
+    }
+  }
+  context.replacePinAccess(std::move(update));
+}
+
+}  // namespace drt::io
