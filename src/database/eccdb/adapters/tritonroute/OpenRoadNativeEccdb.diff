+DatabasePtr readRoutedDatabase(const std::filesystem::path& path, utl::Logger& logger)
+{
+  DatabasePtr database(odb::dbDatabase::create(), odb::dbDatabase::destroy);
+  std::ifstream input(path, std::ios::binary);
+  if (!input) {
+    throw std::runtime_error("cannot read routed ODB snapshot: " + path.string());
+  }
+  database->read(input);
+  database->setLogger(&logger);
+  return database;
+}
+
+DatabasePtr importRoutedDef(const std::filesystem::path& lef,
+                            const std::filesystem::path& def,
+                            utl::Logger& logger)
+{
+  DatabasePtr database(odb::dbDatabase::create(), odb::dbDatabase::destroy);
+  database->setLogger(&logger);
+  odb::lefin lef_reader(database.get(), &logger, false);
+  if (lef_reader.createTechAndLib("eccdb_compare_tech", "eccdb_compare_lib", lef.c_str()) == nullptr) {
+    throw std::runtime_error("cannot import comparison LEF: " + lef.string());
+  }
+  auto* chip = odb::dbChip::create(database.get(), database->getTech());
+  std::vector<odb::dbLib*> libraries;
+  for (auto* library : database->getLibs()) {
+    libraries.push_back(library);
+  }
+  odb::defin def_reader(database.get(), &logger);
+  def_reader.readChip(libraries, def.c_str(), chip);
+  if (chip->getBlock() == nullptr) {
+    throw std::runtime_error("cannot import EccDB routed DEF: " + def.string());
+  }
+  return database;
+}
