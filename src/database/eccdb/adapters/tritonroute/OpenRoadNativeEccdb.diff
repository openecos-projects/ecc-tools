+TEST_F(EccdbAdapterTest, RoutesRoundTripThroughAdapter)
+{
+  auto* net = makeNet("signal");
+  const auto net_id = design_store_.netlistStorage().createNet(
+      eccdb::DesignNet{.name = "signal", .non_default_rule = {}, .design_non_default_rule = {}});
+  eccdb::DatabaseContext database_context(technology_, library_, design_store_);
+  eccdb::RoutingService route_service(database_context);
+  const std::vector<eccdb::RouteShape> original{eccdb::RouteSegment{.layer = m1_,
+                                                                      .begin = {0, 0},
+                                                                      .end = {50, 0},
+                                                                      .width = std::nullopt,
+                                                                      .begin_extension = std::nullopt,
+                                                                      .end_extension = std::nullopt}};
+  static_cast<void>(route_service.replaceRouted(net_id, std::span<const eccdb::RouteShape>{original}));
+  makePathseg(net, drtM1Layer(), {0, 20}, {20, 20});
+
+  io::EccdbRouteAdapter adapter(context_, *design);
+  ASSERT_NO_THROW(adapter.readRoutes());
+  ASSERT_EQ(net->getShapes().size(), 1u);
+  EXPECT_FALSE(net->isFixed());
+  EXPECT_TRUE(net->hasInitialRouting());
+  const auto* imported = static_cast<const frPathSeg*>(net->getShapes().front().get());
+  EXPECT_EQ(imported->getLayerNum(), drtM1Layer());
+  EXPECT_EQ(imported->getBeginPoint(), (odb::Point{0, 0}));
+  EXPECT_EQ(imported->getEndPoint(), (odb::Point{50, 0}));
+  EXPECT_EQ(imported->getStyle().getWidth(), 100u);
+
+  auto* edited = static_cast<frPathSeg*>(net->getShapes().front().get());
+  edited->setPoints({20, 0}, {80, 0});
+  ASSERT_NO_THROW(adapter.writeRoutes());
+
+  const auto snapshot = route_service.snapshot(net_id);
+  ASSERT_EQ(snapshot.wires.size(), 1u);
+  EXPECT_EQ(snapshot.wires.front().status, eccdb::DesignWireStatus::kRouted);
+  ASSERT_EQ(snapshot.wires.front().shapes.size(), 1u);
+  const auto& written = std::get<eccdb::RouteSegment>(snapshot.wires.front().shapes.front());
+  EXPECT_EQ(written.layer, m1_);
+  EXPECT_EQ(written.begin, (eccdb::Point{20, 0}));
+  EXPECT_EQ(written.end, (eccdb::Point{80, 0}));
+  EXPECT_FALSE(written.width.has_value());
+}
