+void importEccdbDesign(EccdbDesign& result, const RouteInputs& inputs)
+{
+  eccdb::LefTechImporter(result.technology).import(inputs.input_lef);
+  eccdb::LefLibraryImporter(result.technology, result.library).import(inputs.input_lef);
+  eccdb::DefDesignImporter(result.design).import(inputs.input_def);
+}
