+RouteResult runBaseline(const RouteInputs& inputs, const RouteArtifacts& artifacts)
+{
+  RouteHarness harness(inputs.preroute_db);
+  return harness.route(artifacts);
+}
+
+RouteResult runEccdbAdapter(const RouteInputs& inputs,
+                            const RouteArtifacts& artifacts,
+                            std::size_t& input_guide_count,
+                            std::size_t& input_gcell_grid_count)
+{
+  EccdbDesign eccdb;
+  importEccdbDesign(eccdb, inputs);
+  RouteHarness harness(inputs.preroute_db);
+  input_gcell_grid_count = copyPreRouteGCellGrids(*harness.getDatabase(), eccdb);
+  input_guide_count = copyPreRouteGuides(*harness.getDatabase(), eccdb);
+  harness.attachEccdb(eccdb);
+  auto result = harness.route(artifacts);
+  result.eccdb_routing = eccdbRoutingCounts(eccdb.design);
+  result.eccdb_gcell_grid_count = eccdb.design.floorplanStorage().gcellGridCount();
+
+  eccdb::DefDesignExporter(eccdb.design).write(artifacts.eccdb_def);
+  if (!std::filesystem::is_regular_file(artifacts.eccdb_def)
+      || std::filesystem::file_size(artifacts.eccdb_def) == 0) {
+    throw std::runtime_error("EccDB DEF exporter produced no output: "
+                             + artifacts.eccdb_def.string());
+  }
+  eccdb::DesignStore roundtripped(eccdb.technology.techRegistry(), eccdb.library.libraryRegistry());
+  eccdb::DefDesignImporter(roundtripped).import(artifacts.eccdb_def);
+  if (roundtripped.netlistStorage().regularNets().empty()) {
+    throw std::runtime_error("EccDB DEF exporter output cannot be imported into a design");
+  }
+  result.exported_eccdb_routing = eccdbRoutingCounts(roundtripped);
+  result.exported_eccdb_gcell_grid_count = roundtripped.floorplanStorage().gcellGridCount();
+  return result;
+}
+
+std::size_t firstDifference(const std::string& lhs, const std::string& rhs)
+{
+  const auto limit = std::min(lhs.size(), rhs.size());
+  for (std::size_t index = 0; index < limit; ++index) {
+    if (lhs[index] != rhs[index]) {
+      return index;
+    }
+  }
+  return limit;
+}
+
+TEST(EccdbRouteFlowTest, RoutedEccdbGeometryMatchesOdbAndOptionalBaseline)
+{
+  std::string missing;
+  const auto inputs = readInputs(missing);
+  if (!inputs) {
+    GTEST_SKIP() << missing;
+  }
+
+  requireRegularFile(inputs->preroute_db, "ECCDB_DRT_PREROUTE_DB");
+  requireRegularFile(inputs->input_lef, "ECCDB_DRT_INPUT_LEF");
+  requireRegularFile(inputs->input_def, "ECCDB_DRT_INPUT_DEF");
+  std::filesystem::create_directories(inputs->output_directory);
+
+  const auto baseline_artifacts = makeArtifacts(inputs->output_directory,
+                                                "eccdb-route-flow-baseline");
+  const auto adapter_artifacts = makeArtifacts(inputs->output_directory,
+                                               "eccdb-route-flow-adapter");
+  const char* skip_baseline = std::getenv("ECCDB_DRT_SKIP_BASELINE");
+  const bool run_baseline = skip_baseline == nullptr || std::string_view(skip_baseline) != "1";
+  if (run_baseline && routeThreads() != 1) {
+    throw std::invalid_argument(
+        "byte-exact baseline comparison requires one thread; set ECCDB_DRT_SKIP_BASELINE=1 for parallel routing");
+  }
+  std::optional<RouteResult> baseline;
+  if (run_baseline) {
+    baseline = runBaseline(*inputs, baseline_artifacts);
+  }
+  std::size_t input_guide_count = 0;
+  std::size_t input_gcell_grid_count = 0;
+  const auto adapter = runEccdbAdapter(*inputs,
+                                       adapter_artifacts,
+                                       input_guide_count,
+                                       input_gcell_grid_count);
+
+  std::cout << "EccDB route-flow artifacts:\n";
+  if (run_baseline) {
+    std::cout << "  baseline ODB DEF: " << baseline_artifacts.odb_def << '\n';
+  }
+  std::cout << "  adapter ODB DEF: " << adapter_artifacts.odb_def << '\n'
+            << "  adapter EccDB DEF: " << adapter_artifacts.eccdb_def << '\n'
+            << "  adapter EccDB GCELLGRID patterns: " << adapter.eccdb_gcell_grid_count
+            << " (exported: " << adapter.exported_eccdb_gcell_grid_count << ")\n"
+            << "  adapter EccDB routing: wires=" << adapter.eccdb_routing.wires
+            << " paths=" << adapter.eccdb_routing.paths
+            << " vias=" << adapter.eccdb_routing.vias << '\n'
+            << "  exported EccDB routing: wires=" << adapter.exported_eccdb_routing.wires
+            << " paths=" << adapter.exported_eccdb_routing.paths
+            << " vias=" << adapter.exported_eccdb_routing.vias
+            << '\n';
+
+  EXPECT_GT(input_guide_count, 0u);
+  EXPECT_GT(input_gcell_grid_count, 0u);
+  if (baseline) {
+    EXPECT_EQ(baseline->drc_count, 0) << "baseline artifacts are under " << inputs->output_directory;
+    EXPECT_GT(baseline->routed_net_count, 0u);
+  }
+  EXPECT_EQ(adapter.drc_count, 0) << "adapter artifacts are under " << inputs->output_directory;
+  EXPECT_GT(adapter.routed_net_count, 0u);
+  EXPECT_GT(adapter.eccdb_routing.wires, 0u);
+  EXPECT_GT(adapter.eccdb_routing.paths, 0u);
+  EXPECT_GT(adapter.eccdb_routing.vias, 0u);
+  EXPECT_EQ(adapter.eccdb_gcell_grid_count, input_gcell_grid_count);
+  EXPECT_EQ(adapter.exported_eccdb_routing.wires, adapter.eccdb_routing.wires);
+  EXPECT_EQ(adapter.exported_eccdb_routing.paths, adapter.eccdb_routing.paths);
+  EXPECT_EQ(adapter.exported_eccdb_routing.vias, adapter.eccdb_routing.vias);
+  EXPECT_EQ(adapter.exported_eccdb_gcell_grid_count, adapter.eccdb_gcell_grid_count);
+
+  if (baseline) {
+    EXPECT_EQ(baseline->odb_def, adapter.odb_def)
+        << "ODB DEFs differ at byte "
+        << firstDifference(baseline->odb_def, adapter.odb_def) << "; inspect "
+        << baseline_artifacts.odb_def << " and " << adapter_artifacts.odb_def;
+  }
+
+  utl::Logger comparison_logger;
+  auto routed_odb = readRoutedDatabase(adapter_artifacts.odb_database, comparison_logger);
+  auto eccdb_as_odb = importRoutedDef(inputs->input_lef,
+                                      adapter_artifacts.eccdb_def,
+                                      comparison_logger);
+  auto* routed_block = routed_odb->getChip()->getBlock();
+  auto* eccdb_block = eccdb_as_odb->getChip()->getBlock();
+  ASSERT_NE(routed_block, nullptr);
+  ASSERT_NE(eccdb_block, nullptr);
+  const auto difference = compareRoutedBlocks(routed_block, eccdb_block);
+  EXPECT_FALSE(difference.has_value()) << difference.value_or("");
+
+  // Verify that the comparison detects a missing route rather than passing on net names alone.
+  bool checked_missing_route = false;
+  for (auto* net : eccdb_block->getNets()) {
+    if (auto* wire = net->getWire()) {
+      odb::dbWire::destroy(wire);
+      const auto missing_route = compareRoutedBlocks(routed_block, eccdb_block);
+      EXPECT_TRUE(missing_route.has_value());
+      checked_missing_route = true;
+      break;
+    }
+  }
+  EXPECT_TRUE(checked_missing_route);
+}
