+  context.replaceGuides(net_id,
+                        {{.box = {0, 0, 40, 40},
+                          .layer = m1_,
+                          .via_layer = m1_,
+                          .flags = eccdb::DesignRouteGuideFlag::kCongested}});
+  EXPECT_THROW(adapter.readInputGuides(*net), std::invalid_argument);
