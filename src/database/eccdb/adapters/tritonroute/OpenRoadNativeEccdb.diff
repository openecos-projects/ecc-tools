+                          .flags = eccdb::DesignRouteGuideFlag::kJumper
+                                   | eccdb::DesignRouteGuideFlag::kConnectedToTerm}});
+  context.replaceGuides(special_id,
+                        {{.box = {0, 0, 20, 20},
+                          .layer = m1_,
+                          .via_layer = {},
+                          .flags = eccdb::DesignRouteGuideFlag::kCongested}});
