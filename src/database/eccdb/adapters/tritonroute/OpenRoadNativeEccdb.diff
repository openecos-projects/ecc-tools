+EccdbRoutingCounts eccdbRoutingCounts(const eccdb::DesignStore& design)
+{
+  const auto statistics = design.routingStorage().routingStatistics();
+  return {.wires = design.routingStorage().wireCount(),
+          .paths = statistics.paths.count,
+          .vias = statistics.vias.count};
+}
+
+eccdb::TechRoutingLayerId requireRoutingLayer(const eccdb::TechStore& technology,
+                                              const odb::dbTechLayer* layer)
+{
+  if (layer == nullptr) {
+    return {};
+  }
+  const auto found = technology.findLayer(layer->getName());
+  const auto routing = eccdb::TechRoutingLayerId{found.entity()};
+  if (!found || !technology.routingLayerStorage().contains(routing)) {
+    throw std::runtime_error("EccDB has no routing layer named " + std::string(layer->getName()));
+  }
+  return routing;
+}
+
+std::size_t copyPreRouteGCellGrids(odb::dbDatabase& database, EccdbDesign& eccdb)
+{
+  auto* chip = database.getChip();
+  auto* block = chip == nullptr ? nullptr : chip->getBlock();
+  if (block == nullptr) {
+    throw std::runtime_error("pre-route ODB snapshot has no top block");
+  }
+
+  auto& floorplan = eccdb.design.floorplanStorage();
+  // read_guides may update this grid, so the snapshot is authoritative.
+  for (const auto id : floorplan.gcellGrids()) {
+    static_cast<void>(floorplan.destroyGCellGrid(id));
+  }
+
+  auto* grid = block->getGCellGrid();
+  if (grid == nullptr) {
+    return 0;
+  }
+
+  const auto add_pattern = [&](eccdb::DesignAxis axis,
+                               int start,
+                               int line_count,
+                               int step) {
+    if (line_count <= 0 || step <= 0) {
+      throw std::runtime_error("pre-route ODB snapshot has an invalid GCELLGRID pattern");
+    }
+    static_cast<void>(floorplan.createGCellGrid({.axis = axis,
+                                                 .start = start,
+                                                 .line_count = static_cast<uint32_t>(line_count),
+                                                 .step = step}));
+  };
+
+  std::size_t pattern_count = 0;
+  for (int index = 0; index < grid->getNumGridPatternsX(); ++index) {
+    int start = 0;
+    int line_count = 0;
+    int step = 0;
+    grid->getGridPatternX(index, start, line_count, step);
+    add_pattern(eccdb::DesignAxis::kX, start, line_count, step);
+    ++pattern_count;
+  }
+  for (int index = 0; index < grid->getNumGridPatternsY(); ++index) {
+    int start = 0;
+    int line_count = 0;
+    int step = 0;
+    grid->getGridPatternY(index, start, line_count, step);
+    add_pattern(eccdb::DesignAxis::kY, start, line_count, step);
+    ++pattern_count;
+  }
+  return pattern_count;
+}
+
+std::size_t copyPreRouteGuides(odb::dbDatabase& database, EccdbDesign& eccdb)
+{
+  auto* chip = database.getChip();
+  auto* block = chip == nullptr ? nullptr : chip->getBlock();
+  if (block == nullptr) {
+    throw std::runtime_error("pre-route ODB snapshot has no top block");
+  }
+
+  eccdb::DatabaseContext database_context(eccdb.technology, eccdb.library, eccdb.design);
+  eccdb::RoutingService context(database_context);
+  std::size_t guide_count = 0;
+  for (auto* net : block->getNets()) {
+    if (net->isSpecial()) {
+      continue;
+    }
+    const auto net_id = eccdb.design.netlistStorage().findRegularNet(net->getName());
+    if (!net_id) {
+      throw std::runtime_error("EccDB has no regular net named " + std::string(net->getName()));
+    }
+
+    std::vector<eccdb::DesignRouteGuide> guides;
+    guides.reserve(net->getGuides().size());
+    for (auto* guide : net->getGuides()) {
+      const auto box = guide->getBox();
+      uint32_t flags = 0;
+      if (guide->isCongested()) {
+        flags |= eccdb::DesignRouteGuideFlag::kCongested;
+      }
+      if (guide->isJumper()) {
+        flags |= eccdb::DesignRouteGuideFlag::kJumper;
+      }
+      if (guide->isConnectedToTerm()) {
+        flags |= eccdb::DesignRouteGuideFlag::kConnectedToTerm;
+      }
+      guides.push_back({.box = {box.xMin(), box.yMin(), box.xMax(), box.yMax()},
+                        .layer = requireRoutingLayer(eccdb.technology, guide->getLayer()),
+                        .via_layer = requireRoutingLayer(eccdb.technology, guide->getViaLayer()),
+                        .flags = flags});
+    }
+    if (!guides.empty()) {
+      guide_count += guides.size();
+      context.replaceGuides(net_id, std::move(guides));
+    }
+  }
+  return guide_count;
+}
