+int routeThreads()
+{
+  const char* value = std::getenv("ECCDB_DRT_THREADS");
+  if (value == nullptr || value[0] == '\0') {
+    return 1;
+  }
+  const std::string_view text(value);
+  int threads = 0;
+  const auto result = std::from_chars(text.data(), text.data() + text.size(), threads);
+  if (result.ec != std::errc{} || result.ptr != text.data() + text.size() || threads <= 0) {
+    throw std::invalid_argument("ECCDB_DRT_THREADS must be a positive integer");
+  }
+  return threads;
+}
