+                                                          .status = eccdb::DesignWireStatus::kRouted,
+                                                          .shield_net = {},
+                                                          .shapes = {}});
+  static_cast<void>(routing.createShape(
+      wire,
+      eccdb::DesignRouteShape{.wire = {},
+                              .layer = m1_,
+                              .geometry = eccdb::DesignRoutePoint{
+                                  .point = {.position = {20, 0}, .flags = eccdb::DesignWirePointFlag::kVirtual}}}));
+
+  io::EccdbRouteAdapter adapter(context_, *design);
+  EXPECT_THROW(adapter.readRoutes(), std::invalid_argument);
+  EXPECT_TRUE(net->getShapes().empty());
