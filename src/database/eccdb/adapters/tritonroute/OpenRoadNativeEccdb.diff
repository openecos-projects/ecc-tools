+EccdbContextAdapter::EccdbContextAdapter(eccdb::DatabaseContext& context, frDesign& route_design)
+    : context_(context), design_(context.design()), technology_(*context.technology()),
+      library_(*context.library()), route_design_(route_design)
+{
+}
+
+std::vector<frRect> EccdbContextAdapter::readInputGuides(const frNet& net) const
+{
+  if (net.isSpecial()) {
+    return {};
+  }
+  auto& database_context = context_;
+  PhysicalDesignService physical(database_context);
+  const auto& context = design_.guideStorage();
+  const auto net_id = physical.findRegularNet(net.getName());
+  if (!net_id) {
+    throw std::runtime_error("EccDB has no regular net named " + net.getName());
+  }
+
+  std::vector<frRect> result;
+  const auto guides = context.guides(net_id);
+  result.reserve(guides.size());
+  for (const auto guide_id : guides) {
+    const auto& guide = context.guide(guide_id);
+    if ((guide.flags & eccdb::DesignRouteGuideFlag::kCongested) != 0u) {
+      throw std::invalid_argument("Input route guides are congested");
+    }
+    auto* layer = requireFrLayer(physical, route_design_, guide.layer);
+    frRect rectangle;
+    rectangle.setBBox(toOdb(guide.box));
+    rectangle.setLayerNum(layer->getLayerNum());
+    result.push_back(std::move(rectangle));
+  }
+  return result;
+}
+
+void EccdbContextAdapter::readContext()
+{
+  auto& database_context = context_;
+  PhysicalDesignService physical(database_context);
+  std::optional<eccdb::DesignGCellGrid> x_grid;
+  std::optional<eccdb::DesignGCellGrid> y_grid;
+  physical.forEachGCellGrid([&](const auto, const eccdb::DesignGCellGrid& grid) {
+    if (grid.line_count == 0u || grid.step <= 0) {
+      throw std::invalid_argument("EccDB GCell grid has nonpositive count or step");
+    }
+    if (grid.axis != eccdb::DesignAxis::kX && grid.axis != eccdb::DesignAxis::kY) {
+      throw std::invalid_argument("EccDB GCell grid has an invalid axis");
+    }
+    auto& axis_grid = grid.axis == eccdb::DesignAxis::kX ? x_grid : y_grid;
+    if (axis_grid) {
+      throw std::invalid_argument("DRT supports at most one EccDB GCell grid per axis");
+    }
+    axis_grid = grid;
+  });
+  if (x_grid || y_grid) {
+    if (!x_grid || !y_grid) {
+      throw std::invalid_argument("DRT requires both X and Y EccDB GCell grid patterns");
+    }
+    auto* block = route_design_.getTopBlock();
+    if (block == nullptr) {
+      throw std::logic_error("DRT design must be loaded before EccDB GCell grid input");
+    }
+    block->setGCellPatterns(
+        {frGCellPattern(/*horizontal=*/false,
+                        x_grid->start,
+                        static_cast<frUInt4>(x_grid->step),
+                        static_cast<frUInt4>(x_grid->line_count)),
+         frGCellPattern(/*horizontal=*/true,
+                        y_grid->start,
+                        static_cast<frUInt4>(y_grid->step),
+                        static_cast<frUInt4>(y_grid->line_count))});
+  }
+  readPinAccess();
+}
+
+void EccdbContextAdapter::readPinAccess()
+{
+  auto& database_context = context_;
+  PhysicalDesignService physical(database_context);
+  const auto& context = design_.pinAccessStorage();
+  const auto vias = buildViaLookup(physical);
+  CandidateReferenceMap references;
+  populateMasterPortCandidates(context, physical, route_design_, vias, references);
+  populateIoPinCandidates(context, physical, route_design_, vias);
+  populateInstancePreferences(context, physical, route_design_, references);
+}
