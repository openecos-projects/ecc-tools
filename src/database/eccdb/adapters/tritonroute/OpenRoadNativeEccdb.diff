+class RouteHarness
+{
+ public:
+  explicit RouteHarness(const std::filesystem::path& preroute_db)
+      : services_(&logger_),
+        distributed_(&logger_),
+        steiner_(&logger_),
+        database_(odb::dbDatabase::create(), odb::dbDatabase::destroy)
+  {
+    std::ifstream input(preroute_db, std::ios::binary);
+    if (!input) {
+      throw std::runtime_error("cannot read pre-route ODB snapshot: " + preroute_db.string());
+    }
+    database_->read(input);
+    database_->setLogger(&logger_);
+
+    router_ = std::make_unique<drt::TritonRoute>(
+        database_.get(), &logger_, &services_, &distributed_, &steiner_);
+    router_->initGraphics(std::make_unique<NullGraphicsFactory>());
+  }
+
+  void attachEccdb(EccdbDesign& eccdb)
+  {
+    router_->attachEccdb(eccdb.context);
+  }
+
+  [[nodiscard]] odb::dbDatabase* getDatabase() const { return database_.get(); }
+
+  [[nodiscard]] RouteResult route(const RouteArtifacts& artifacts)
+  {
+    drt::ParamStruct params;
+    params.outputMazeFile = artifacts.maze_log.string();
+    params.outputDrcFile = artifacts.drc_report.string();
+    params.outputGuideCoverageFile = artifacts.guide_coverage.string();
+    params.enableViaGen = true;
+    params.drouteEndIter = -1;
+    params.orSeed = 0;
+    params.orK = 0;
+    params.verbose = 0;
+    params.doPa = true;
+    params.num_threads = routeThreads();
+    router_->setParams(params);
+
+    if (router_->main() != 0) {
+      throw std::runtime_error("TritonRoute::main returned a non-zero status");
+    }
+
+    auto* block = database_->getChip() == nullptr ? nullptr : database_->getChip()->getBlock();
+    if (block == nullptr) {
+      throw std::runtime_error("route run removed the ODB top block");
+    }
+
+    odb::DefOut def_out(&logger_);
+    if (!def_out.writeBlock(block, artifacts.odb_def.string().c_str())) {
+      throw std::runtime_error("cannot write routed ODB DEF: " + artifacts.odb_def.string());
+    }
+    writeDatabase(artifacts.odb_database);
+
+    RouteResult result;
+    result.odb_def = readText(artifacts.odb_def);
+    result.drc_count = router_->getNumDRVs();
+    for (auto* net : block->getNets()) {
+      if (net->getWire() != nullptr) {
+        ++result.routed_net_count;
+      }
+    }
+    return result;
+  }
+
+ private:
+  void writeDatabase(const std::filesystem::path& path) const
+  {
+    std::ofstream output(path, std::ios::binary);
+    if (!output) {
+      throw std::runtime_error("cannot write routed ODB snapshot: " + path.string());
+    }
+    database_->write(output);
+    if (!output) {
+      throw std::runtime_error("failed while writing routed ODB snapshot: " + path.string());
+    }
+  }
+
+  static std::string readText(const std::filesystem::path& path)
+  {
+    std::ifstream input(path, std::ios::binary);
+    if (!input) {
+      throw std::runtime_error("cannot read routed ODB DEF: " + path.string());
+    }
+    std::ostringstream contents;
+    contents << input.rdbuf();
+    return contents.str();
+  }
+
+  utl::Logger logger_;
+  utl::ServiceRegistry services_;
+  dst::Distributed distributed_;
+  stt::SteinerTreeBuilder steiner_;
+  DatabasePtr database_;
+  std::unique_ptr<drt::TritonRoute> router_;
+};
+
+struct RoutePrimitive
+{
+  enum Kind { kSegment, kTechVia, kBlockVia, kPatch } kind = kSegment;
+  std::string layer;
+  std::string name;
+  std::string mask;
+  int wire_type = 0;
+  int x1 = 0;
+  int y1 = 0;
+  int x2 = 0;
+  int y2 = 0;
+  std::optional<int> first_extension;
+  std::optional<int> second_extension;
+
+  auto fields() const
+  {
+    return std::tie(kind, layer, name, mask, wire_type, x1, y1, x2, y2,
+                    first_extension, second_extension);
+  }
+  bool operator<(const RoutePrimitive& rhs) const { return fields() < rhs.fields(); }
+  bool operator==(const RoutePrimitive& rhs) const { return fields() == rhs.fields(); }
+
+  std::string describe() const
+  {
+    std::ostringstream out;
+    out << static_cast<int>(kind) << ' ' << layer << ' ' << name << " (" << x1 << ',' << y1
+        << ") (" << x2 << ',' << y2 << ") type=" << wire_type << " mask=" << mask;
+    if (kind == kSegment) {
+      out << " ext=";
+      if (first_extension) {
+        out << *first_extension;
+      } else {
+        out << "default";
+      }
+      out << ',';
+      if (second_extension) {
+        out << *second_extension;
+      } else {
+        out << "default";
+      }
+    }
+    return out.str();
+  }
+};
+
+struct WireSignature
+{
+  std::vector<RoutePrimitive> primitives;
+  std::vector<RoutePrimitive> physical_shapes;
+  std::vector<RoutePrimitive> via_boxes;
+};
+
+std::string colorKey(std::optional<uint8_t> color)
+{
+  return color ? std::to_string(*color) : "none";
+}
+
+std::string viaColorKey(std::optional<odb::dbWireDecoder::ViaColor> color)
+{
+  if (!color) {
+    return "none";
+  }
+  return std::to_string(color->bottom_color) + ',' + std::to_string(color->cut_color)
+         + ',' + std::to_string(color->top_color);
+}
+
+WireSignature wireSignature(odb::dbWire* wire)
+{
+  WireSignature signature;
+  odb::dbWireDecoder decoder;
+  decoder.begin(wire);
+  struct Point
+  {
+    int x;
+    int y;
+    std::optional<int> extension;
+  };
+  std::optional<Point> previous;
+  odb::dbTechLayer* layer = nullptr;
+  int wire_type = 0;
+
+  for (auto opcode = decoder.next(); opcode != odb::dbWireDecoder::END_DECODE;
+       opcode = decoder.next()) {
+    switch (opcode) {
+      case odb::dbWireDecoder::PATH:
+      case odb::dbWireDecoder::JUNCTION:
+        layer = decoder.getLayer();
+        wire_type = decoder.getWireType().getValue();
+        previous.reset();
+        break;
+      case odb::dbWireDecoder::SHORT:
+      case odb::dbWireDecoder::VWIRE:
+        throw std::runtime_error("virtual or short wire cannot be compared as physical routing");
+      case odb::dbWireDecoder::POINT:
+      case odb::dbWireDecoder::POINT_EXT: {
+        Point current{0, 0, std::nullopt};
+        if (opcode == odb::dbWireDecoder::POINT_EXT) {
+          int extension = 0;
+          decoder.getPoint(current.x, current.y, extension);
+          current.extension = extension;
+        } else {
+          decoder.getPoint(current.x, current.y);
+        }
+        if (previous && (previous->x != current.x || previous->y != current.y)) {
+          if (layer == nullptr) {
+            throw std::runtime_error("wire segment has no routing layer");
+          }
+          RoutePrimitive primitive;
+          primitive.kind = RoutePrimitive::kSegment;
+          primitive.layer = layer->getName();
+          primitive.mask = colorKey(decoder.getColor());
+          primitive.wire_type = wire_type;
+          primitive.x1 = previous->x;
+          primitive.y1 = previous->y;
+          primitive.x2 = current.x;
+          primitive.y2 = current.y;
+          primitive.first_extension = previous->extension;
+          primitive.second_extension = current.extension;
+          if (std::tie(primitive.x2, primitive.y2) < std::tie(primitive.x1, primitive.y1)) {
+            std::swap(primitive.x1, primitive.x2);
+            std::swap(primitive.y1, primitive.y2);
+            std::swap(primitive.first_extension, primitive.second_extension);
+          }
+          signature.primitives.push_back(std::move(primitive));
+        }
+        previous = current;
+        break;
+      }
+      case odb::dbWireDecoder::VIA:
+      case odb::dbWireDecoder::TECH_VIA: {
+        if (!previous) {
+          throw std::runtime_error("wire VIA has no anchor point");
+        }
+        RoutePrimitive primitive;
+        primitive.kind = opcode == odb::dbWireDecoder::VIA ? RoutePrimitive::kBlockVia
+                                                            : RoutePrimitive::kTechVia;
+        primitive.wire_type = wire_type;
+        primitive.x1 = previous->x;
+        primitive.y1 = previous->y;
+        primitive.mask = viaColorKey(decoder.getViaColor());
+        if (opcode == odb::dbWireDecoder::VIA) {
+          auto* via = decoder.getVia();
+          primitive.name = via->getName();
+          if (via->isViaRotated()) {
+            primitive.name += ':' + std::to_string(via->getOrient().getValue());
+          }
+        } else {
+          primitive.name = decoder.getTechVia()->getName();
+        }
+        signature.primitives.push_back(std::move(primitive));
+        layer = decoder.getLayer();
+        previous->extension.reset();
+        break;
+      }
+      case odb::dbWireDecoder::RECT: {
+        if (!previous || layer == nullptr) {
+          throw std::runtime_error("wire patch has no anchor point or routing layer");
+        }
+        int dx1 = 0;
+        int dy1 = 0;
+        int dx2 = 0;
+        int dy2 = 0;
+        decoder.getRect(dx1, dy1, dx2, dy2);
+        RoutePrimitive primitive;
+        primitive.kind = RoutePrimitive::kPatch;
+        primitive.layer = layer->getName();
+        primitive.mask = colorKey(decoder.getColor());
+        primitive.wire_type = wire_type;
+        primitive.x1 = previous->x + std::min(dx1, dx2);
+        primitive.y1 = previous->y + std::min(dy1, dy2);
+        primitive.x2 = previous->x + std::max(dx1, dx2);
+        primitive.y2 = previous->y + std::max(dy1, dy2);
+        signature.primitives.push_back(std::move(primitive));
+        break;
+      }
+      case odb::dbWireDecoder::RULE:
+      case odb::dbWireDecoder::ITERM:
+      case odb::dbWireDecoder::BTERM:
+      case odb::dbWireDecoder::END_DECODE:
+        break;
+    }
+  }
+  std::sort(signature.primitives.begin(), signature.primitives.end());
+
+  odb::dbWireShapeItr shapes;
+  odb::dbShape shape;
+  for (shapes.begin(wire); shapes.next(shape);) {
+    RoutePrimitive primitive;
+    primitive.kind = shape.isVia()
+                         ? (shape.getTechVia() == nullptr ? RoutePrimitive::kBlockVia
+                                                           : RoutePrimitive::kTechVia)
+                         : RoutePrimitive::kSegment;
+    if (shape.isVia()) {
+      primitive.name = shape.getTechVia() == nullptr ? shape.getVia()->getName()
+                                                     : shape.getTechVia()->getName();
+    } else {
+      primitive.layer = shape.getTechLayer()->getName();
+    }
+    const auto box = shape.getBox();
+    primitive.x1 = box.xMin();
+    primitive.y1 = box.yMin();
+    primitive.x2 = box.xMax();
+    primitive.y2 = box.yMax();
+    signature.physical_shapes.push_back(std::move(primitive));
+    if (shape.isVia()) {
+      std::vector<odb::dbShape> boxes;
+      odb::dbShape::getViaBoxes(shape, boxes);
+      for (const auto& via_box : boxes) {
+        RoutePrimitive box_primitive;
+        box_primitive.kind = shape.getTechVia() == nullptr ? RoutePrimitive::kBlockVia
+                                                            : RoutePrimitive::kTechVia;
+        box_primitive.name = shape.getTechVia() == nullptr ? shape.getVia()->getName()
+                                                            : shape.getTechVia()->getName();
+        box_primitive.layer = via_box.getTechLayer()->getName();
+        const auto rectangle = via_box.getBox();
+        box_primitive.x1 = rectangle.xMin();
+        box_primitive.y1 = rectangle.yMin();
+        box_primitive.x2 = rectangle.xMax();
+        box_primitive.y2 = rectangle.yMax();
+        signature.via_boxes.push_back(std::move(box_primitive));
+      }
+    }
+  }
+  std::sort(signature.physical_shapes.begin(), signature.physical_shapes.end());
+  std::sort(signature.via_boxes.begin(), signature.via_boxes.end());
+  return signature;
+}
+
+std::optional<std::string> comparePrimitives(const std::vector<RoutePrimitive>& expected,
+                                             const std::vector<RoutePrimitive>& actual,
+                                             std::string_view category)
+{
+  if (expected.size() != actual.size()) {
+    return std::string(category) + " count: " + std::to_string(expected.size()) + " vs "
+           + std::to_string(actual.size());
+  }
+  for (std::size_t index = 0; index < expected.size(); ++index) {
+    if (!(expected[index] == actual[index])) {
+      return std::string(category) + " at index " + std::to_string(index) + ": "
+             + expected[index].describe() + " vs " + actual[index].describe();
+    }
+  }
+  return std::nullopt;
+}
+
+std::vector<std::string> netPins(odb::dbNet* net)
+{
+  std::vector<std::string> pins;
+  for (auto* iterm : net->getITerms()) {
+    pins.push_back(std::string(iterm->getInst()->getName()) + '/'
+                   + iterm->getMTerm()->getName());
+  }
+  for (auto* bterm : net->getBTerms()) {
+    pins.push_back(std::string("PIN/") + bterm->getName());
+  }
+  std::sort(pins.begin(), pins.end());
+  return pins;
+}
+
+std::optional<std::string> compareRoutedBlocks(odb::dbBlock* expected,
+                                                odb::dbBlock* actual)
+{
+  for (auto* net : expected->getNets()) {
+    auto* counterpart = actual->findNet(net->getName().c_str());
+    if (counterpart == nullptr) {
+      return std::string("missing net ") + net->getName();
+    }
+    const std::string context = std::string("net ") + net->getName() + ": ";
+    if (net->getSigType().getValue() != counterpart->getSigType().getValue()) {
+      return context + "signal type differs";
+    }
+    const auto rule_name = [](odb::dbNet* value) {
+      auto* rule = value->getNonDefaultRule();
+      return rule == nullptr ? std::string{} : rule->getName();
+    };
+    if (rule_name(net) != rule_name(counterpart)) {
+      return context + "non-default rule differs";
+    }
+    if (netPins(net) != netPins(counterpart)) {
+      return context + "connected terminals differ";
+    }
+    if (net->getSWires().size() != 0 || counterpart->getSWires().size() != 0) {
+      return context + "special-wire geometry is outside the route adapter comparison";
+    }
+    auto* wire = net->getWire();
+    auto* other_wire = counterpart->getWire();
+    if ((wire == nullptr) != (other_wire == nullptr)) {
+      return context + "routed wire is missing on one side";
+    }
+    if (wire == nullptr) {
+      continue;
+    }
+    const auto lhs = wireSignature(wire);
+    const auto rhs = wireSignature(other_wire);
+    if (lhs.primitives.empty() || rhs.primitives.empty()) {
+      return context + "routed wire has no representable physical primitives";
+    }
+    if (const auto difference = comparePrimitives(lhs.primitives, rhs.primitives, "wire primitive")) {
+      return context + *difference;
+    }
+    if (const auto difference = comparePrimitives(lhs.physical_shapes, rhs.physical_shapes, "physical shape")) {
+      return context + *difference;
+    }
+    if (const auto difference = comparePrimitives(lhs.via_boxes, rhs.via_boxes, "VIA geometry")) {
+      return context + *difference;
+    }
+  }
+  for (auto* net : actual->getNets()) {
+    if (expected->findNet(net->getName().c_str()) == nullptr) {
+      return std::string("unexpected net ") + net->getName();
+    }
+  }
+  return std::nullopt;
+}
