+  const auto& written_guide = context.guide(written.front());
+  EXPECT_EQ(written_guide.box, (eccdb::Rect{10, 10, 90, 50}));
+  EXPECT_EQ(written_guide.layer, m1_);
+  EXPECT_EQ(written_guide.via_layer, m1_);
+  EXPECT_EQ(written_guide.flags, 0u);
+
+  const auto preserved = context.guides(special_id);
+  ASSERT_EQ(preserved.size(), 1u);
+  const auto& preserved_guide = context.guide(preserved.front());
+  EXPECT_EQ(preserved_guide.box, (eccdb::Rect{0, 0, 20, 20}));
