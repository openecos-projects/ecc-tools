+
+static_assert(std::numeric_limits<int>::digits >= std::numeric_limits<int32_t>::digits,
+              "EccDB route coordinates require a 32-bit DRT coordinate type");
+static_assert(std::numeric_limits<int>::digits <= std::numeric_limits<int32_t>::digits,
+              "EccDB route coordinates cannot safely represent this DRT coordinate type");
+
+struct PreparedRoute
+{
+  bool fixed = false;
+  bool has_initial_routing = false;
+  std::vector<std::unique_ptr<frShape>> shapes;
+  std::vector<std::unique_ptr<frVia>> vias;
+  std::vector<std::unique_ptr<frShape>> patches;
+};
+
+[[nodiscard]] std::string netContext(std::string_view name)
+{
+  return " on net " + std::string{name};
+}
+
+[[nodiscard]] odb::Point toOdb(eccdb::Point point)
+{
+  return {static_cast<int>(point.x), static_cast<int>(point.y)};
+}
+
+[[nodiscard]] eccdb::Point toEccdb(odb::Point point)
+{
+  return {static_cast<int32_t>(point.x()), static_cast<int32_t>(point.y())};
+}
+
+[[nodiscard]] int32_t checkedInt32(frUInt4 value, std::string_view description)
+{
+  if (value > static_cast<frUInt4>(std::numeric_limits<int32_t>::max())) {
+    throw std::overflow_error(std::string{description} + " exceeds EccDB's int32 range");
+  }
+  return static_cast<int32_t>(value);
+}
+
+[[nodiscard]] frUInt4 checkedFrUInt4(int32_t value, std::string_view description)
+{
+  if (value < 0) {
+    throw std::invalid_argument(std::string{description} + " must not be negative");
+  }
+  return static_cast<frUInt4>(value);
+}
+
+[[nodiscard]] frTechObject& requireFrTech(frDesign& route_design)
+{
+  auto* tech = route_design.getTech();
+  if (tech == nullptr) {
+    throw std::logic_error("DRT technology must be loaded before EccDB routing");
+  }
+  return *tech;
+}
+
+[[nodiscard]] frLayer* requireFrLayer(const eccdb::TechStore& tech, frDesign& route_design, eccdb::TechRoutingLayerId id)
+{
+  const auto& name = tech.routingLayerStorage().layerInfo(id).name;
+  auto* layer = requireFrTech(route_design).getLayer(name);
+  if (layer == nullptr) {
+    throw std::runtime_error("DRT has no routing layer named " + name);
+  }
+  return layer;
+}
+
+[[nodiscard]] frLayer* requireFrLayer(frDesign& route_design, frLayerNum number)
+{
+  if (number < 0) {
+    throw std::invalid_argument("DRT route shape has a negative layer number");
+  }
+  try {
+    auto* layer = requireFrTech(route_design).getLayer(number);
+    if (layer == nullptr) {
+      throw std::runtime_error("DRT route shape has no layer");
+    }
+    return layer;
+  } catch (const std::out_of_range&) {
+    throw std::runtime_error("DRT route shape references an unknown layer number " + std::to_string(number));
+  }
+}
+
+[[nodiscard]] eccdb::TechRoutingLayerId requireEccdbLayer(const eccdb::TechStore& tech, const frLayer* layer)
+{
+  if (layer == nullptr) {
+    throw std::invalid_argument("DRT route shape has no layer");
+  }
+  const auto id = tech.findLayer(layer->getName());
+  if (!id) {
+    throw std::runtime_error("EccDB has no routing layer named " + layer->getName());
+  }
+  const auto routing = eccdb::TechRoutingLayerId{id.entity()};
+  if (!tech.routingLayerStorage().contains(routing)) {
+    throw std::runtime_error("EccDB layer " + layer->getName() + " is not a routing layer");
+  }
+  return routing;
+}
+
+[[nodiscard]] eccdb::TechLayerId requireEccdbViaLayer(const eccdb::TechStore& tech,
+                                                       frDesign& route_design,
+                                                       const frShape& figure,
+                                                       odb::dbTechLayerType expected_type,
+                                                       std::string_view via_name,
+                                                       std::string_view figure_group)
+{
+  const auto* layer = requireFrLayer(route_design, figure.getLayerNum());
+  if (layer->getType() != expected_type) {
+    throw std::invalid_argument("DRT router-created VIA " + std::string{via_name} + " has a "
+                                + std::string{figure_group} + " figure on the wrong layer type");
+  }
+
+  const auto eccdb_layer = tech.findLayer(layer->getName());
+  if (!eccdb_layer) {
+    throw std::runtime_error("EccDB has no layer named " + layer->getName() + " for router-created VIA "
+                             + std::string{via_name});
+  }
+
+  const bool routing_layer = tech.routingLayerStorage().contains(eccdb::TechRoutingLayerId{eccdb_layer.entity()});
+  const bool cut_layer = tech.cutLayerStorage().contains(eccdb::TechCutLayerId{eccdb_layer.entity()});
+  const bool expected_routing = expected_type == odb::dbTechLayerType::ROUTING;
+  if ((expected_routing && !routing_layer) || (!expected_routing && !cut_layer)) {
+    throw std::runtime_error("EccDB layer " + layer->getName() + " has the wrong type for router-created VIA "
+                             + std::string{via_name});
+  }
+  return eccdb_layer;
+}
+
+void appendRouterViaFigures(eccdb::DesignViaInput& destination,
+                            const std::vector<std::unique_ptr<frShape>>& figures,
+                            const eccdb::TechStore& tech,
+                            frDesign& route_design,
+                            odb::dbTechLayerType expected_type,
+                            std::string_view via_name,
+                            std::string_view figure_group)
+{
+  if (figures.empty()) {
+    throw std::invalid_argument("DRT router-created VIA " + std::string{via_name} + " has no "
+                                + std::string{figure_group} + " figures");
+  }
+
+  for (const auto& figure : figures) {
+    if (figure == nullptr) {
+      throw std::invalid_argument("DRT router-created VIA " + std::string{via_name} + " has a null "
+                                  + std::string{figure_group} + " figure");
+    }
+    const auto box = figure->getBBox();
+    const eccdb::Rect rectangle{.ll_x = static_cast<int32_t>(box.xMin()),
+                                .ll_y = static_cast<int32_t>(box.yMin()),
+                                .ur_x = static_cast<int32_t>(box.xMax()),
+                                .ur_y = static_cast<int32_t>(box.yMax())};
+    if (!rectangle.hasArea()) {
+      throw std::invalid_argument("DRT router-created VIA " + std::string{via_name} + " has a zero-area "
+                                  + std::string{figure_group} + " figure");
+    }
+    destination.rectangles.push_back(eccdb::DesignViaRectangle{
+        .layer = requireEccdbViaLayer(tech, route_design, *figure, expected_type, via_name, figure_group),
+        .rectangle = rectangle});
+  }
+}
+
+[[nodiscard]] eccdb::DesignViaId createRouterAddedVia(eccdb::RoutingService& design_vias,
+                                                        const eccdb::TechStore& tech,
+                                                        frDesign& route_design,
+                                                        const frViaDef& via)
+{
+  if (!via.isAddedByRouter()) {
+    throw std::invalid_argument("DRT VIA was not created by the router: " + via.getName());
+  }
+
+  eccdb::DesignViaInput value;
+  value.name = via.getName();
+  if (value.name.empty()) {
+    throw std::invalid_argument("DRT router-created VIA has no name");
+  }
+  value.rectangles.reserve(via.getLayer1Figs().size() + via.getCutFigs().size() + via.getLayer2Figs().size());
+  appendRouterViaFigures(value,
+                         via.getLayer1Figs(),
+                         tech,
+                         route_design,
+                         odb::dbTechLayerType::ROUTING,
+                         value.name,
+                         "lower routing");
+  appendRouterViaFigures(value,
+                         via.getCutFigs(),
+                         tech,
+                         route_design,
+                         odb::dbTechLayerType::CUT,
+                         value.name,
+                         "cut");
+  appendRouterViaFigures(value,
+                         via.getLayer2Figs(),
+                         tech,
+                         route_design,
+                         odb::dbTechLayerType::ROUTING,
+                         value.name,
+                         "upper routing");
+  return design_vias.createVia(std::move(value));
+}
+
+[[nodiscard]] std::optional<std::string> eccdbNdrName(const eccdb::DesignStore& design,
+                                                        const eccdb::TechStore& tech,
+                                                        eccdb::DesignNetId net)
+{
+  const auto& value = design.netlistStorage().net(net);
+  if (value.non_default_rule && value.design_non_default_rule) {
+    throw std::logic_error("EccDB net references both a technology and a design non-default rule");
+  }
+  if (value.non_default_rule) {
+    const auto& rules = tech.nonDefaultRuleStorage();
+    if (!rules.contains(value.non_default_rule)) {
+      throw std::logic_error("EccDB net references a missing technology non-default rule");
+    }
+    return rules.nonDefaultRule(value.non_default_rule).name;
+  }
+  if (value.design_non_default_rule) {
+    const auto& rules = design.routingStorage();
+    if (!rules.contains(value.design_non_default_rule)) {
+      throw std::logic_error("EccDB net references a missing design non-default rule");
+    }
+    return rules.nonDefaultRule(value.design_non_default_rule).name;
+  }
+  return std::nullopt;
+}
+
+void validateNdrCompatibility(const eccdb::DesignStore& design,
+                              const eccdb::TechStore& tech,
+                              eccdb::DesignNetId id,
+                              const frNet& net)
+{
+  const auto expected = eccdbNdrName(design, tech, id);
+  const auto* actual = net.getNondefaultRule();
+  if (!expected && actual != nullptr) {
+    throw std::runtime_error("DRT has an unexpected non-default rule" + netContext(net.getName()));
+  }
+  if (expected && (actual == nullptr || actual->getName() != *expected)) {
+    throw std::runtime_error("DRT and EccDB non-default rules differ" + netContext(net.getName()));
+  }
+}
+
+[[nodiscard]] int32_t eccdbEffectiveWidth(const eccdb::DesignStore& design,
+                                           const eccdb::TechStore& tech,
+                                           eccdb::DesignNetId net,
+                                           eccdb::TechRoutingLayerId layer)
+{
+  const auto& value = design.netlistStorage().net(net);
+  if (value.non_default_rule) {
+    if (const auto* rule = tech.nonDefaultRuleStorage().routingRule(value.non_default_rule, layer); rule != nullptr) {
+      if (rule->width <= 0) {
+        throw std::logic_error("EccDB technology non-default rule has a non-positive width");
+      }
+      return rule->width;
+    }
+  }
+  if (value.design_non_default_rule) {
+    const auto& rule = design.routingStorage().nonDefaultRule(value.design_non_default_rule);
+    const auto target = eccdb::TechLayerId{layer.entity()};
+    const auto found = std::find_if(rule.layer_rules.begin(), rule.layer_rules.end(), [&](const auto& layer_rule) {
+      return layer_rule.layer == target;
+    });
+    if (found != rule.layer_rules.end()) {
+      if (found->width <= 0) {
+        throw std::logic_error("EccDB design non-default rule has a non-positive width");
+      }
+      return found->width;
+    }
+  }
+  const auto width = tech.routingLayerStorage().routingLayer(layer).width;
+  if (width <= 0) {
+    throw std::logic_error("EccDB routing layer has a non-positive default width");
+  }
+  return width;
+}
+
+[[nodiscard]] int32_t drtEffectiveWidth(const frNet& net, const frLayer* layer)
+{
+  if (layer == nullptr) {
+    throw std::invalid_argument("DRT route shape has no layer");
+  }
+  const auto default_width = checkedInt32(layer->getWidth(), "DRT routing layer width");
+  if (default_width <= 0) {
+    throw std::invalid_argument("DRT routing layer has a non-positive default width");
+  }
+  const auto* ndr = net.getNondefaultRule();
+  if (ndr == nullptr) {
+    return default_width;
+  }
+  const auto layer_number = layer->getLayerNum();
+  if (layer_number <= 0 || (layer_number % 2) != 0) {
+    throw std::logic_error("DRT routing layer number cannot index a non-default rule");
+  }
+  const auto width = ndr->getWidth(layer_number / 2 - 1);
+  if (width < 0) {
+    throw std::logic_error("DRT non-default rule has a negative width");
+  }
+  return width == 0 ? default_width : width;
+}
+
+[[nodiscard]] int32_t validateEffectiveWidth(const eccdb::DesignStore& design,
+                                              const eccdb::TechStore& tech,
+                                              eccdb::DesignNetId id,
+                                              const frNet& net,
+                                              eccdb::TechRoutingLayerId eccdb_layer,
+                                              const frLayer* drt_layer)
+{
+  const auto eccdb_width = eccdbEffectiveWidth(design, tech, id, eccdb_layer);
+  const auto drt_width = drtEffectiveWidth(net, drt_layer);
+  if (eccdb_width != drt_width) {
+    throw std::runtime_error("DRT and EccDB effective route widths differ" + netContext(net.getName()));
+  }
+  return eccdb_width;
+}
+
+[[nodiscard]] frSegStyle toFrStyle(const eccdb::RouteSegment& segment,
+                                   int32_t style_width,
+                                   int32_t default_extension_width)
+{
+  if (style_width <= 0 || default_extension_width <= 0) {
+    throw std::invalid_argument("EccDB route segment has a non-positive width");
+  }
+  if (segment.width && *segment.width != style_width) {
+    throw std::invalid_argument("EccDB ordinary-net segment width differs from its layer or non-default rule");
+  }
+  frSegStyle style;
+  const auto width = checkedFrUInt4(style_width, "EccDB route segment width");
+  const auto default_extension = checkedFrUInt4(default_extension_width, "EccDB route extension width") / 2u;
+  style.setWidth(width);
+  const auto set_end = [default_extension](frSegStyle& target, bool begin, std::optional<int32_t> extension) {
+    const auto kind = extension == 0 ? frcTruncateEndStyle
+                      : extension.has_value() ? frcVariableEndStyle
+                                              : frcExtendEndStyle;
+    const auto value = extension.has_value() ? checkedFrUInt4(*extension, "EccDB route extension") : default_extension;
+    if (begin) {
+      target.setBeginStyle(frEndStyle(kind), value);
+    } else {
+      target.setEndStyle(frEndStyle(kind), value);
+    }
+  };
+  set_end(style, true, segment.begin_extension);
+  set_end(style, false, segment.end_extension);
+  return style;
+}
+
+[[nodiscard]] std::optional<int32_t> toEccdbExtension(frEndStyle style, frUInt4 value, frUInt4 implicit_extension)
+{
+  if (style == frcTruncateEndStyle) {
+    return 0;
+  }
+  if (style == frcExtendEndStyle) {
+    return value == implicit_extension ? std::nullopt : std::optional<int32_t>{checkedInt32(value, "DRT route extension")};
+  }
+  if (style == frcVariableEndStyle) {
+    return checkedInt32(value, "DRT route extension");
+  }
+  throw std::invalid_argument("DRT route segment has an unknown end style");
+}
+
+[[nodiscard]] eccdb::RouteSegment normalizedSegment(eccdb::RouteSegment segment)
+{
+  if (segment.begin == segment.end) {
+    throw std::invalid_argument("DRT cannot represent a zero-length EccDB route segment");
+  }
+  if (segment.begin.x != segment.end.x && segment.begin.y != segment.end.y) {
+    throw std::invalid_argument("DRT cannot represent a non-Manhattan EccDB route segment");
+  }
+  const bool reverse = segment.begin.x == segment.end.x ? segment.end.y < segment.begin.y : segment.end.x < segment.begin.x;
+  if (reverse) {
+    std::swap(segment.begin, segment.end);
+    std::swap(segment.begin_extension, segment.end_extension);
+  }
+  return segment;
+}
+
+[[nodiscard]] std::string routeViaName(const eccdb::DesignStore& design,
+                                       const eccdb::TechStore& tech,
+                                       const eccdb::RouteViaDefinition& definition)
+{
+  return std::visit(
+      [&](const auto id) -> std::string {
+        using ViaId = std::remove_cvref_t<decltype(id)>;
+        if constexpr (std::is_same_v<ViaId, eccdb::TechViaMasterId>) {
+          return tech.viaMasterStorage().viaMaster(id).name;
+        } else {
+          return design.routingStorage().via(id).name;
+        }
+      },
+      definition);
+}
+
+[[nodiscard]] const frViaDef* requireFrVia(const eccdb::DesignStore& design,
+                                            const eccdb::TechStore& tech,
+                                            frDesign& route_design,
+                                            const eccdb::RouteViaDefinition& definition)
+{
+  const auto name = routeViaName(design, tech, definition);
+  if (name.empty()) {
+    throw std::invalid_argument("EccDB route VIA has no name");
+  }
+  if (tech.viaMasterStorage().findViaMaster(name) && design.routingStorage().findVia(name)) {
+    throw std::runtime_error("EccDB has both a technology and a design VIA named " + name);
+  }
+  try {
+    const auto* via = requireFrTech(route_design).getVia(name);
+    if (via == nullptr) {
+      throw std::runtime_error("DRT has no VIA named " + name);
+    }
+    return via;
+  } catch (const std::out_of_range&) {
+    throw std::runtime_error("DRT has no VIA named " + name);
+  }
+}
+
+[[nodiscard]] std::unique_ptr<frPatchWire> makeFrPatch(const eccdb::RoutePatch& patch,
+                                                        const eccdb::TechStore& tech,
+                                                        frDesign& route_design)
+{
+  if (!patch.rectangle.hasArea()) {
+    throw std::invalid_argument("EccDB route patch has no area");
+  }
+  auto result = std::make_unique<frPatchWire>();
+  result->setLayerNum(requireFrLayer(tech, route_design, patch.layer)->getLayerNum());
+  const auto width = patch.rectangle.width();
+  const auto height = patch.rectangle.height();
+  if (width <= std::numeric_limits<int>::max() && height <= std::numeric_limits<int>::max()) {
+    result->setOrigin({static_cast<int>(patch.rectangle.ll_x), static_cast<int>(patch.rectangle.ll_y)});
+    result->setOffsetBox({0, 0, static_cast<int>(width), static_cast<int>(height)});
+  } else {
+    // A zero origin preserves every absolute coordinate when a lower-left
+    // relative offset would overflow DRT's signed integer representation.
+    result->setOrigin({0, 0});
+    result->setOffsetBox({static_cast<int>(patch.rectangle.ll_x),
+                          static_cast<int>(patch.rectangle.ll_y),
+                          static_cast<int>(patch.rectangle.ur_x),
+                          static_cast<int>(patch.rectangle.ur_y)});
+  }
+  return result;
+}
+
+[[nodiscard]] std::optional<int32_t> pointExtension(eccdb::DesignWirePoint point)
+{
+  return (point.flags & eccdb::DesignWirePointFlag::kHasExtension) != 0u ? std::optional<int32_t>{point.extension}
+                                                                          : std::nullopt;
+}
+
+[[nodiscard]] eccdb::RouteViaDefinition routeViaDefinition(const eccdb::DesignWireVia& via)
+{
+  if (via.tech_via && !via.design_via) {
+    return eccdb::RouteViaDefinition{via.tech_via};
+  }
+  if (via.design_via && !via.tech_via) {
+    return eccdb::RouteViaDefinition{via.design_via};
+  }
+  throw std::logic_error("EccDB wire VIA does not have exactly one definition");
+}
+
+[[nodiscard]] eccdb::Point checkedOffsetPoint(eccdb::Point origin, int64_t offset_x, int64_t offset_y)
+{
+  const auto checked_coordinate = [](int64_t value) -> int32_t {
+    if (value < std::numeric_limits<int32_t>::min() || value > std::numeric_limits<int32_t>::max()) {
+      throw std::overflow_error("EccDB VIA array placement overflows int32");
+    }
+    return static_cast<int32_t>(value);
+  };
+  return {.x = checked_coordinate(static_cast<int64_t>(origin.x) + offset_x),
+          .y = checked_coordinate(static_cast<int64_t>(origin.y) + offset_y)};
+}
+
+[[nodiscard]] int32_t inputSegmentWidth(const frLayer& layer, const eccdb::RouteSegment& segment)
+{
+  const auto default_width = checkedInt32(layer.getWidth(), "DRT routing layer width");
+  if (default_width <= 0) {
+    throw std::logic_error("DRT routing layer has a non-positive default width");
+  }
+  const bool wrong_way = (layer.isHorizontal() && segment.begin.y != segment.end.y)
+                         || (!layer.isHorizontal() && segment.begin.x != segment.end.x);
+  if (!wrong_way) {
+    return default_width;
+  }
+  const auto wrong_way_width = checkedInt32(layer.getWrongDirWidth(), "DRT routing layer wrong-direction width");
+  if (wrong_way_width <= 0) {
+    throw std::logic_error("DRT routing layer has a non-positive wrong-direction width");
+  }
+  return wrong_way_width;
+}
+
+[[nodiscard]] std::unique_ptr<frPathSeg> makeFrInputSegment(eccdb::RouteSegment segment,
+                                                             const eccdb::DesignStore& design,
+                                                             const eccdb::TechStore& tech,
+                                                             eccdb::DesignNetId net_id,
+                                                             const frNet& net,
+                                                             frDesign& route_design)
+{
+  segment = normalizedSegment(std::move(segment));
+  auto* layer = requireFrLayer(tech, route_design, segment.layer);
+  const auto default_width = checkedInt32(layer->getWidth(), "DRT routing layer width");
+  // DEF TAPER disables a net NDR for that path. Ordinary non-tapered paths
+  // retain the net's NDR width, exactly as the ODB-backed import does.
+  const auto style_width = segment.tapered ? inputSegmentWidth(*layer, segment)
+                                           : validateEffectiveWidth(design, tech, net_id, net, segment.layer, layer);
+
+  auto result = std::make_unique<frPathSeg>();
+  result->setPoints(toOdb(segment.begin), toOdb(segment.end));
+  result->setLayerNum(layer->getLayerNum());
+  result->setStyle(toFrStyle(segment, style_width, default_width));
+  result->setTapered(segment.tapered);
+  return result;
+}
+
+void appendInputShape(PreparedRoute& destination,
+                      const eccdb::DesignStore& design,
+                      const eccdb::TechStore& tech,
+                      eccdb::DesignNetId net_id,
+                      const frNet& net,
+                      frDesign& route_design,
+                      const eccdb::DesignRouteShape& shape,
+                      const eccdb::DesignRouteShapeAttributes*,
+                      std::string_view net_name)
+{
+  constexpr uint32_t kUnsupportedFlags = eccdb::DesignWirePathFlag::kHasTaperRule | eccdb::DesignWirePathFlag::kHasStyle;
+  if ((shape.flags & kUnsupportedFlags) != 0u) {
+    throw std::invalid_argument("DRT cannot represent EccDB TAPERRULE or STYLE metadata" + netContext(net_name));
+  }
+  if ((shape.flags & eccdb::DesignWirePathFlag::kHasWidth) != 0u) {
+    throw std::invalid_argument("DRT cannot import explicit ordinary-net route width metadata" + netContext(net_name));
+  }
+  if ((shape.flags & eccdb::DesignWirePathFlag::kHasShape) != 0u) {
+    throw std::invalid_argument("DRT cannot import SPECIALNET SHAPE metadata on an ordinary EccDB net" + netContext(net_name));
+  }
+
+  const auto require_physical_point = [&](eccdb::DesignWirePoint point) {
+    if ((point.flags & eccdb::DesignWirePointFlag::kVirtual) != 0u) {
+      // A virtual point is a DEF serialization transition, not copper. frNet
+      // has no equivalent primitive, and materializing one would be wrong.
+      throw std::invalid_argument("DRT frNet cannot represent an EccDB VIRTUAL route point" + netContext(net_name));
+    }
+  };
+  // ODB's DRT materialization does not consume route-layer or VIA mask
+  // coloring. Keep the physical projection and leave those cold attributes in
+  // EccDB rather than rejecting an otherwise routable Shape.
+  const bool tapered = (shape.flags & eccdb::DesignWirePathFlag::kTaper) != 0u;
+
+  std::visit(
+      [&](const auto& geometry) {
+        using Geometry = std::remove_cvref_t<decltype(geometry)>;
+        if constexpr (std::is_same_v<Geometry, eccdb::DesignRouteSegment>) {
+          require_physical_point(geometry.begin);
+          require_physical_point(geometry.end);
+          destination.shapes.push_back(makeFrInputSegment(
+              eccdb::RouteSegment{.layer = shape.layer,
+                                   .begin = geometry.begin.position,
+                                   .end = geometry.end.position,
+                                   .width = std::nullopt,
+                                   .begin_extension = pointExtension(geometry.begin),
+                                   .end_extension = pointExtension(geometry.end),
+                                   .tapered = tapered},
+              design,
+              tech,
+              net_id,
+              net,
+              route_design));
+          destination.has_initial_routing = true;
+        } else if constexpr (std::is_same_v<Geometry, eccdb::DesignRoutePatch>) {
+          require_physical_point(geometry.anchor);
+          destination.patches.push_back(makeFrPatch(
+              eccdb::RoutePatch{.layer = shape.layer, .rectangle = geometry.rectangle, .tapered = tapered}, tech, route_design));
+          destination.has_initial_routing = true;
+        } else if constexpr (std::is_same_v<Geometry, eccdb::DesignRouteVia>) {
+          require_physical_point(geometry.origin);
+          if (!eccdb::isValidDesignOrientation(geometry.via.orientation)) {
+            throw std::logic_error("EccDB route VIA has an invalid orientation" + netContext(net_name));
+          }
+          if (geometry.via.orientation != eccdb::DesignOrientation::kN) {
+            // frVia stores a definition but not a useful orientation. Preserve
+            // the source value in EccDB rather than projecting wrong geometry.
+            throw std::invalid_argument("DRT frVia cannot represent an oriented EccDB VIA" + netContext(net_name));
+          }
+          const auto definition = routeViaDefinition(geometry.via);
+          const auto* via_definition = requireFrVia(design, tech, route_design, definition);
+          const bool has_array = (geometry.via.flags & eccdb::DesignWireViaFlag::kHasArray) != 0u;
+          const uint32_t columns = has_array ? geometry.via.columns : 1u;
+          const uint32_t rows = has_array ? geometry.via.rows : 1u;
+          const int64_t step_x = has_array ? geometry.via.step_x : 0;
+          const int64_t step_y = has_array ? geometry.via.step_y : 0;
+          // ODB and DRT both represent each array member as a concrete VIA.
+          for (uint32_t column = 0; column < columns; ++column) {
+            for (uint32_t row = 0; row < rows; ++row) {
+              const auto origin = checkedOffsetPoint(geometry.origin.position,
+                                                     static_cast<int64_t>(column) * step_x,
+                                                     static_cast<int64_t>(row) * step_y);
+              auto result = std::make_unique<frVia>(via_definition, toOdb(origin));
+              result->setTapered(tapered);
+              destination.vias.push_back(std::move(result));
+            }
+          }
+          destination.has_initial_routing = true;
+        } else {
+          require_physical_point(geometry.point);
+          throw std::invalid_argument("DRT frNet cannot import an EccDB point-only route Shape" + netContext(net_name));
+        }
+      },
+      shape.geometry);
+}
+
+}  // namespace
+
+EccdbRouteAdapter::EccdbRouteAdapter(eccdb::DatabaseContext& context, frDesign& route_design)
+    : context_(context), design_(context.design()), tech_(*context.technology()),
+      library_(*context.library()), route_design_(route_design)
+{
+}
+
+void EccdbRouteAdapter::readRoutes()
+{
+  auto& database_context = context_;
+  const eccdb::PhysicalDesignService physical(database_context);
+  auto* block = route_design_.getTopBlock();
+  if (block == nullptr) {
+    throw std::logic_error("DRT design must be loaded before EccDB routing");
+  }
+
+  for (const auto& net : block->getNets()) {
+    if (net->isSpecial()) {
+      continue;
+    }
+    if (!design_.netlistStorage().findRegularNet(net->getName())) {
+      throw std::runtime_error("EccDB has no ordinary net named " + net->getName());
+    }
+  }
+
+  design_.netlistStorage().forEachRegularNet([&](eccdb::DesignNetId id, const eccdb::DesignNet& design_net) {
+    auto* net = block->findNet(design_net.name);
+    if (net == nullptr || net->isSpecial()) {
+      throw std::runtime_error("DRT has no ordinary net named " + design_net.name);
+    }
+    validateNdrCompatibility(design_, tech_, id, *net);
+
+    // Construct one net's replacement before deleting the current DRT route.
+    // Shapes are already canonical route primitives, so importing them does
+    // not decode a DEF path or allocate a RouteShape snapshot.
+    PreparedRoute replacement;
+    bool has_routed_wire = false;
+    bool has_fixed_wire = false;
+    physical.forEachNetWire(id, [&](eccdb::DesignWireId, const eccdb::DesignWire& wire) {
+      if (wire.status == eccdb::DesignWireStatus::kRouted) {
+        has_routed_wire = true;
+      } else if (wire.status == eccdb::DesignWireStatus::kFixed) {
+        has_fixed_wire = true;
+      } else {
+        throw std::invalid_argument("DRT cannot import non-routed/non-fixed EccDB wire" + netContext(design_net.name));
+      }
+    });
+    physical.forEachNetWireShape(id, [&](eccdb::DesignWireId, const eccdb::DesignWire&, eccdb::DesignRouteShapeId,
+                                         const eccdb::DesignRouteShape& shape,
+                                         const eccdb::DesignRouteShapeAttributes* attributes) {
+      appendInputShape(replacement, design_, tech_, id, *net, route_design_, shape, attributes, design_net.name);
+    });
+    if (has_routed_wire && has_fixed_wire) {
+      throw std::invalid_argument("DRT cannot preserve mixed routed and fixed EccDB wires" + netContext(design_net.name));
+    }
+    replacement.fixed = has_fixed_wire;
+
+    net->clearRoutes();
+    net->setFixed(replacement.fixed);
+    for (auto& shape : replacement.shapes) {
+      net->addShape(std::move(shape));
+    }
+    for (auto& via : replacement.vias) {
+      net->addVia(std::move(via));
+    }
+    for (auto& patch : replacement.patches) {
+      net->addPatchWire(std::move(patch));
+    }
+    net->setHasInitialRouting(replacement.has_initial_routing);
+  });
+}
+
+void EccdbRouteAdapter::writeRoutes()
+{
+  auto& database_context = context_;
+  eccdb::RoutingService routes(database_context);
+  auto& design_vias = routes;
+  auto* block = route_design_.getTopBlock();
+  if (block == nullptr) {
+    throw std::logic_error("DRT design must be loaded before EccDB routing");
+  }
+
+  for (const auto& net : block->getNets()) {
+    if (net->isSpecial()) {
+      continue;
+    }
+    if (!design_.netlistStorage().findRegularNet(net->getName())) {
+      throw std::runtime_error("EccDB has no ordinary net named " + net->getName());
+    }
+  }
+
+  design_.netlistStorage().forEachRegularNet([&](eccdb::DesignNetId id, const eccdb::DesignNet& design_net) {
+    auto* net = block->findNet(design_net.name);
+    if (net == nullptr || net->isSpecial()) {
+      throw std::runtime_error("DRT has no ordinary net named " + design_net.name);
+    }
+    // RoutingService only replaces routed Wires. Keeping a fixed net
+    // read-only avoids flattening its physical status into routed geometry.
+    if (net->isFixed()) {
+      return;
+    }
+    validateNdrCompatibility(design_, tech_, id, *net);
+
+    std::vector<eccdb::RouteShape> shapes;
+    shapes.reserve(net->getShapes().size() + net->getVias().size() + net->getPatchWires().size());
+    for (const auto& shape : net->getShapes()) {
+      if (shape->typeId() != frcPathSeg) {
+        throw std::invalid_argument("DRT route contains an unsupported shape" + netContext(design_net.name));
+      }
+      const auto& path = *static_cast<const frPathSeg*>(shape.get());
+      const auto begin = path.getBeginPoint();
+      const auto end = path.getEndPoint();
+      if (begin.x() == end.x() && begin.y() == end.y()) {
+        throw std::invalid_argument("DRT route contains a zero-length segment" + netContext(design_net.name));
+      }
+      if (begin.x() != end.x() && begin.y() != end.y()) {
+        throw std::invalid_argument("DRT route contains a non-Manhattan segment" + netContext(design_net.name));
+      }
+      auto* layer = requireFrLayer(route_design_, path.getLayerNum());
+      const auto eccdb_layer = requireEccdbLayer(tech_, layer);
+      const eccdb::RouteSegment candidate{.layer = eccdb_layer,
+                                           .begin = toEccdb(begin),
+                                           .end = toEccdb(end),
+                                           .width = std::nullopt,
+                                           .begin_extension = std::nullopt,
+                                           .end_extension = std::nullopt,
+                                           .tapered = path.isTapered()};
+      const auto implicit_width = path.isTapered()
+                                      ? inputSegmentWidth(*layer, candidate)
+                                      : validateEffectiveWidth(design_, tech_, id, *net, eccdb_layer, layer);
+      const auto& style = path.getStyle();
+      if (checkedInt32(style.getWidth(), "DRT route segment width") != implicit_width) {
+        throw std::invalid_argument("DRT route segment width cannot be represented by EccDB ordinary-net routing"
+                                    + netContext(design_net.name));
+      }
+      const auto default_width = checkedFrUInt4(checkedInt32(layer->getWidth(), "DRT routing layer width"),
+                                                "EccDB route segment width");
+      shapes.emplace_back(eccdb::RouteSegment{
+          .layer = eccdb_layer,
+          .begin = toEccdb(begin),
+          .end = toEccdb(end),
+          .width = std::nullopt,
+          .begin_extension = toEccdbExtension(style.getBeginStyle(), style.getBeginExt(), default_width / 2u),
+          .end_extension = toEccdbExtension(style.getEndStyle(), style.getEndExt(), default_width / 2u),
+          .tapered = path.isTapered()});
+    }
+    for (const auto& via : net->getVias()) {
+      if (via == nullptr) {
+        throw std::invalid_argument("DRT route contains a null VIA" + netContext(design_net.name));
+      }
+      const auto* via_def = via->getViaDef();
+      if (via_def == nullptr) {
+        throw std::invalid_argument("DRT route VIA has no definition" + netContext(design_net.name));
+      }
+      const auto& name = via_def->getName();
+      const auto tech_via = tech_.viaMasterStorage().findViaMaster(name);
+      auto design_via = design_vias.findVia(name);
+      if (tech_via && design_via) {
+        throw std::runtime_error("EccDB has both a technology and a design VIA named " + name);
+      }
+      if (!tech_via && !design_via) {
+        if (!via_def->isAddedByRouter()) {
+          throw std::runtime_error("EccDB has no VIA named " + name);
+        }
+        design_via = createRouterAddedVia(design_vias, tech_, route_design_, *via_def);
+      }
+      const eccdb::RouteViaDefinition definition
+          = tech_via ? eccdb::RouteViaDefinition{tech_via} : eccdb::RouteViaDefinition{design_via};
+      if (requireFrVia(design_, tech_, route_design_, definition) != via_def) {
+        throw std::runtime_error("DRT VIA name does not resolve to its EccDB definition" + netContext(design_net.name));
+      }
+      shapes.emplace_back(eccdb::RouteVia{.definition = definition,
+                                           .origin = toEccdb(via->getOrigin()),
+                                           .orientation = eccdb::DesignOrientation::kN,
+                                           .tapered = via->isTapered()});
+    }
+    for (const auto& shape : net->getPatchWires()) {
+      if (shape->typeId() != frcPatchWire) {
+        throw std::invalid_argument("DRT route contains an unsupported patch shape" + netContext(design_net.name));
+      }
+      const auto& patch = *static_cast<const frPatchWire*>(shape.get());
+      const auto box = patch.getBBox();
+      if (box.xMin() >= box.xMax() || box.yMin() >= box.yMax()) {
+        throw std::invalid_argument("DRT route patch has no area" + netContext(design_net.name));
+      }
+      shapes.emplace_back(eccdb::RoutePatch{
+          .layer = requireEccdbLayer(tech_, requireFrLayer(route_design_, patch.getLayerNum())),
+          .rectangle = {static_cast<int32_t>(box.xMin()),
+                        static_cast<int32_t>(box.yMin()),
+                        static_cast<int32_t>(box.xMax()),
+                        static_cast<int32_t>(box.yMax())}});
+    }
+    static_cast<void>(routes.replaceRouted(id, shapes));
+  });
+}
+
+}  // namespace drt::io
