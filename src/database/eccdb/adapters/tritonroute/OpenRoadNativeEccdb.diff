+std::optional<RouteInputs> readInputs(std::string& missing)
+{
+  const auto preroute_db = environmentPath("ECCDB_DRT_PREROUTE_DB");
+  const auto input_lef = environmentPath("ECCDB_DRT_INPUT_LEF");
+  const auto input_def = environmentPath("ECCDB_DRT_INPUT_DEF");
+  const auto output_directory = environmentPath("ECCDB_DRT_OUTPUT_DIR");
+  if (!preroute_db || !input_lef || !input_def || !output_directory) {
+    missing = "set ECCDB_DRT_PREROUTE_DB, ECCDB_DRT_INPUT_LEF, "
+              "ECCDB_DRT_INPUT_DEF, and ECCDB_DRT_OUTPUT_DIR";
+    return std::nullopt;
+  }
+  return RouteInputs{.preroute_db = *preroute_db,
+                     .input_lef = *input_lef,
+                     .input_def = *input_def,
+                     .output_directory = *output_directory};
+}
