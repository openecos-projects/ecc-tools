+// SPDX-License-Identifier: BSD-3-Clause
+
+#pragma once
+
+namespace eccdb {
+class DesignStore;
+class LibraryStore;
+class TechStore;
+class DatabaseContext;
+}
+
+namespace drt {
+class frDesign;
+
+namespace io {
+
+// Converts ordinary routed-net geometry between EccDB's service layer and
+// DRT's frNet model. Technology, masters and logical connectivity remain
+// owned by the existing design reader.
+//
+// readRoutes() replaces the frNet route objects, so call it before those
+// objects have been indexed by frRegionQuery or referenced by pending drUpdate
+// records. It reads native EccDB path views and preserves source-only path
+// attributes in EccDB; frNet receives the same physical subset as the ODB
+// parser.
+class EccdbRouteAdapter
+{
+ public:
+  EccdbRouteAdapter(eccdb::DatabaseContext& context, frDesign& route_design);
+
+  void readRoutes();
+  void writeRoutes();
+
+ private:
+  eccdb::DatabaseContext& context_;
+  eccdb::DesignStore& design_;
+  const eccdb::TechStore& tech_;
+  const eccdb::LibraryStore& library_;
+  frDesign& route_design_;
+};
+
+}  // namespace io
+}  // namespace drt
