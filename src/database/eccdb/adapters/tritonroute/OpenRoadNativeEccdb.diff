+
+// Bridges routing context that has no DEF representation between EccDB and
+// TritonRoute. Route geometry itself belongs to EccdbRouteAdapter.
+class EccdbContextAdapter
+{
+ public:
+  EccdbContextAdapter(eccdb::DatabaseContext& context, frDesign& route_design);
+
+  // EccDB guide input must be injected into GuideProcessor::tmp_guides_.
+  // DRT consumes guide geometry and layer, rejecting congested input guides.
+  // Other guide metadata remains in EccDB unless guide updates are saved.
+  std::vector<frRect> readInputGuides(const frNet& net) const;
+
+  // Loads candidate and preferred access points after the DRT netlist and
+  // masters are available. Guides intentionally use readInputGuides().
+  void readContext();
+  void readPinAccess();
+
+  // Writes DRT-representable context, following SAVE_GUIDE_UPDATES. Track assignments are output-only:
+  // DRT stores them as route objects nested under guides, not as an input
+  // collection independent of guides.
+  void writeContext(bool save_guide_updates);
+  void writeGuides();
+  void writeTrackAssignments();
+  void writePinAccess();
+
+ private:
+  void writeGuideStage(bool save_guides, bool save_assignments);
+  eccdb::DatabaseContext& context_;
+  eccdb::DesignStore& design_;
+  const eccdb::TechStore& technology_;
+  const eccdb::LibraryStore& library_;
+  frDesign& route_design_;
+};
+
+}  // namespace io
+}  // namespace drt
