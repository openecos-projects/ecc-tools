# Two nets touch along x=1000 without overlapping. Touching metal of different nets is
# a short; iDRC reports it as the zero-area overlap of the two rectangles.
case metal_short_abutting
die 0 0 10000 10000
routing M1 dir=H pitch=200
cut V1
rule metal_short
result n1 M1 0 0 1000 100
result n2 M1 1000 0 2000 100
expect metal_short M1 1000 0 1000 100 nets=n1,n2 required=0
# cluster size 1000 puts a cluster boundary exactly on the shared edge
vary pitch=10
