library (bidirectional_test) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1, pf);
  nom_voltage : 1.0;
  nom_temperature : 25;
  nom_process : 1.0;
  type (two_bits) {
    base_type : array;
    data_type : bit;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0;
    downto : true;
  }
  cell (boundary) {
    area : 1;
    pin (send) { direction : input; }
    pin (data) { direction : input; }
    pin (contact) {
      direction : inout;
      function : "data";
      three_state : "!send";
    }
    bus (contacts) {
      bus_type : two_bits;
      direction : inout;
      function : "data";
      three_state : "!send";
      pin (contacts[1:0]) { }
    }
  }
}
