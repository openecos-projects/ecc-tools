# Reject cycles among iSTA targets at configure time.
function(ista_check_target target trail)
  if(";${trail};" MATCHES ";${target};")
    message(FATAL_ERROR "iSTA dependency cycle: ${trail};${target}")
  endif()
  get_property(checked GLOBAL PROPERTY "ista_checked_${target}")
  if(checked)
    return()
  endif()
  foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
    get_target_property(dependencies ${target} ${property})
    foreach(dependency IN LISTS dependencies)
      string(REGEX REPLACE [=[^\$<LINK_ONLY:([^>]+)>$]=] "\\1" dependency "${dependency}")
      if(TARGET "${dependency}" AND dependency MATCHES "^ista_")
        ista_check_target("${dependency}" "${trail};${target}")
      endif()
    endforeach()
  endforeach()
  set_property(GLOBAL PROPERTY "ista_checked_${target}" TRUE)
endfunction()
ista_check_target(ista_interface "")

# Check the reachable dependency closure, including private static-library links.
# A consumer cannot hide a forbidden dependency behind an intermediate target.
function(ista_exclude_dependencies root forbidden)
  set(pending "${root}")
  set(visited "")
  while(pending)
    list(POP_FRONT pending target)
    if(target IN_LIST visited)
      continue()
    endif()
    list(APPEND visited "${target}")
    if(target MATCHES "${forbidden}")
      message(FATAL_ERROR "iSTA domain violation: ${root} reaches ${target}")
    endif()
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(dependencies ${target} ${property})
      foreach(dependency IN LISTS dependencies)
        string(REGEX REPLACE [=[^\$<LINK_ONLY:([^>]+)>$]=] "\\1" dependency "${dependency}")
        if(TARGET "${dependency}" AND dependency MATCHES "^ista_")
          list(APPEND pending "${dependency}")
        endif()
      endforeach()
    endforeach()
  endwhile()
endfunction()

# Consumers are excluded by their functional target families, including leaf components.
set(ista_consumers "timing_reporter|report_.*|.*_report_writer|timing_json_writer|qor_.*|model_extractor|sdf_writer|sdf_.*|liberty_writer|sdc_writer|data_exporter")
ista_exclude_dependencies(ista_timing_analyzer
  "^ista_(interface|reader|sdc_frontend|${ista_consumers})$")
ista_exclude_dependencies(ista_path_checker
  "^ista_(interface|reader|path_analyzer|timing_analyzer|sdc_frontend|${ista_consumers})$")
if(TARGET ista_clock_checker)
  ista_exclude_dependencies(ista_clock_checker
    "^ista_(interface|reader|path_analyzer|timing_analyzer|sdc_frontend|${ista_consumers})$")
endif()
ista_exclude_dependencies(ista_data_exporter
  "^ista_(interface|timing_analyzer|path_analyzer|parasitic_delay|delay_calculator|.*_delay_calculator|sdc_frontend)$")

# Narrow lower-level domains use an allow-list so a newly introduced target cannot silently bypass it.
function(ista_require_dependencies root allowed)
  set(pending "${root}")
  set(visited "")
  while(pending)
    list(POP_FRONT pending target)
    if(target IN_LIST visited)
      continue()
    endif()
    list(APPEND visited "${target}")
    if(NOT target STREQUAL root AND NOT target MATCHES "${allowed}")
      message(FATAL_ERROR "iSTA domain violation: ${root} reaches ${target}")
    endif()
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(dependencies ${target} ${property})
      foreach(dependency IN LISTS dependencies)
        string(REGEX REPLACE [=[^\$<LINK_ONLY:([^>]+)>$]=] "\\1" dependency "${dependency}")
        if(TARGET "${dependency}" AND dependency MATCHES "^ista_")
          list(APPEND pending "${dependency}")
        endif()
      endforeach()
    endforeach()
  endwhile()
endfunction()
