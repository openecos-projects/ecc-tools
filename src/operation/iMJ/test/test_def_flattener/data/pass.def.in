VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN PASS ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 4000 2000 ) ;

COMPONENTS 0 ;
END COMPONENTS

PINS 4 ;
  - IN + NET n_pass + DIRECTION INPUT + USE SIGNAL
    + PORT
      + LAYER M1 ( 0 -100 ) ( 100 100 )
    + FIXED ( 0 1000 ) N ;
  - OUT + NET n_pass + DIRECTION OUTPUT + USE SIGNAL
    + PORT
      + LAYER M1 ( -100 -100 ) ( 0 100 )
    + FIXED ( 4000 1000 ) N ;
  - VPWR1 + NET VPOWER + DIRECTION INOUT + USE POWER
    + PORT
      + LAYER M1 ( 0 -50 ) ( 0 50 )
    + FIXED ( 2000 1500 ) N ;
  - VPWR2 + NET VPOWER + DIRECTION INOUT + USE POWER
    + PORT
      + LAYER M1 ( 0 -50 ) ( 0 50 )
    + FIXED ( 2000 1500 ) N ;
END PINS

SPECIALNETS 1 ;
  - VPOWER ( PIN VPWR1 ) ( PIN VPWR2 ) + USE POWER
    + ROUTED M1 100 ( 0 1500 ) ( 4000 1500 ) ;
END SPECIALNETS

NETS 1 ;
  - n_pass ( PIN IN ) ( PIN OUT ) + USE SIGNAL
    + ROUTED M1 ( 0 1000 ) ( 4000 1000 ) ;
END NETS

END DESIGN
