VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN crop_test ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
ROW ROW_0 CORE 1000 1000 N DO 18 BY 1 STEP 1000 0 ;
ROW ROW_1 CORE 1000 2000 FS DO 18 BY 1 STEP 1000 0 ;
ROW ROW_2 CORE 1000 3000 N DO 18 BY 1 STEP 1000 0 ;
ROW ROW_3 CORE 1000 4000 FS DO 18 BY 1 STEP 1000 0 ;
ROW ROW_4 CORE 1000 5000 N DO 18 BY 1 STEP 1000 0 ;
ROW ROW_5 CORE 1000 6000 FS DO 18 BY 1 STEP 1000 0 ;
ROW ROW_6 CORE 1000 7000 N DO 18 BY 1 STEP 1000 0 ;
ROW ROW_7 CORE 1000 8000 FS DO 18 BY 1 STEP 1000 0 ;
ROW ROW_8 CORE 1000 9000 N DO 18 BY 1 STEP 1000 0 ;
ROW ROW_9 CORE 1000 10000 FS DO 18 BY 1 STEP 1000 0 ;
ROW ROW_10 CORE 1000 11000 N DO 18 BY 1 STEP 1000 0 ;
ROW ROW_11 CORE 1000 12000 FS DO 18 BY 1 STEP 1000 0 ;
ROW ROW_12 CORE 1000 13000 N DO 18 BY 1 STEP 1000 0 ;
ROW ROW_13 CORE 1000 14000 FS DO 18 BY 1 STEP 1000 0 ;
ROW ROW_14 CORE 1000 15000 N DO 18 BY 1 STEP 1000 0 ;
ROW ROW_15 CORE 1000 16000 FS DO 18 BY 1 STEP 1000 0 ;
ROW ROW_16 CORE 1000 17000 N DO 18 BY 1 STEP 1000 0 ;
ROW ROW_17 CORE 1000 18000 FS DO 18 BY 1 STEP 1000 0 ;
TRACKS X 0 DO 100 STEP 200 LAYER M2 ;
TRACKS Y 0 DO 100 STEP 200 LAYER M1 ;
GCELLGRID X 0 DO 21 STEP 1000 ;
GCELLGRID Y 0 DO 21 STEP 1000 ;
VIAS 1 ;
- VDEF
  + RECT M1 ( -60 -60 ) ( 60 60 )
  + RECT V1 ( -25 -25 ) ( 25 25 )
  + RECT M2 ( -60 -60 ) ( 60 60 ) ;
END VIAS
COMPONENTS 5 ;
- u0 BUF + FIXED ( 4000 4000 ) N ;
- u1 BUF + PLACED ( 8000 4000 ) FS ;
- outside BUF + PLACED ( 14000 8000 ) N ;
- partial BUF + PLACED ( 11500 8000 ) N ;
- unplaced BUF + UNPLACED ( 5000 5000 ) N ;
END COMPONENTS
PINS 4 ;
- a + NET a + DIRECTION INPUT + USE SIGNAL
  + LAYER M1 ( -50 -50 ) ( 50 50 ) + FIXED ( 3000 3000 ) N ;
- o + NET out + DIRECTION OUTPUT + USE SIGNAL
  + LAYER M1 ( -50 -50 ) ( 50 50 ) + FIXED ( 16000 5000 ) N ;
- bus + NET bus + DIRECTION INOUT + USE SIGNAL
  + LAYER M2 ( -50 -50 ) ( 50 50 ) + FIXED ( 5000 11000 ) N ;
- spare[0] + NET spare[0] + DIRECTION OUTPUT + USE SIGNAL
  + LAYER M1 ( -50 -50 ) ( 50 50 ) + FIXED ( 11000 11000 ) N ;
END PINS
BLOCKAGES 2 ;
- PLACEMENT RECT ( 1000 6000 ) ( 3000 6500 ) ;
- LAYER M2 RECT ( 11000 11500 ) ( 15000 13000 ) ;
END BLOCKAGES
REGIONS 1 ;
- fence ( 1000 1000 ) ( 18000 18000 ) + TYPE FENCE ;
END REGIONS
GROUPS 2 ;
- grouped u0 u1 + REGION fence ;
- no_region u0 outside ;
END GROUPS
FILLS 2 ;
- LAYER M1 RECT ( 1000 9000 ) ( 3500 9200 ) ;
- VIA VDEF ( 6000 10000 ) ( 11975 10000 ) ;
END FILLS
SPECIALNETS 1 ;
- VDD ( * VPWR ) ( u0 VPWR )
  + USE POWER
  + ROUTED M1 200 ( 1000 5000 0 ) ( 18000 5000 0 )
    NEW M1 0 ( 8000 5000 ) VDEF
;
END SPECIALNETS
NETS 6 ;
- multi ( u0 Y ) ( u1 Y )
  + USE SIGNAL
  + ROUTED M1 ( 1000 4500 ) ( 18000 4500 )
    NEW M1 ( 6000 4500 ) ( 7000 4500 ) V12
    NEW M1 ( 11975 4500 ) V12
;
- a ( PIN a ) ( u0 A ) ( outside A )
  + ROUTED M1 ( 2400 6000 ) RECT ( 0 0 1000 100 )
    NEW M1 ( 5000 7000 -100 ) ( 6000 7000 0 )
;
- out ( u1 A ) ( outside Y ) ( PIN o ) + USE SIGNAL ;
- bus ( PIN bus ) + USE SIGNAL
  + ROUTED M2 ( 5000 11000 ) ( 5000 18000 ) ;
- spare[0] ( PIN spare[0] ) + USE SIGNAL ;
- transit + USE SIGNAL
  + ROUTED M2 ( 9000 1000 ) ( 9000 18000 ) ;
END NETS
END DESIGN
