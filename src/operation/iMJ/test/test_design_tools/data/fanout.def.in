VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN fanout_test ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
TRACKS X 0 DO 100 STEP 200 LAYER M2 ;
TRACKS Y 0 DO 100 STEP 200 LAYER M1 ;
COMPONENTS 6 ;
- A BUF + PLACED ( 4000 4000 ) N ;
- B BUF + PLACED ( 14000 4000 ) N ;
- C BUF + PLACED ( 14000 6000 ) N ;
- D BUF + PLACED ( 14000 8000 ) N ;
- E BUF + PLACED ( 6000 6000 ) N ;
- F BUF + PLACED ( 16000 10000 ) N ;
END COMPONENTS
SPECIALNETS 1 ;
- VDD ( * VPWR ) + USE POWER ;
END SPECIALNETS
NETS 3 ;
- fanout ( A Y ) ( B A ) ( C A ) ( D A ) + USE SIGNAL ;
- mixed ( E A ) ( B Y ) ( F A ) + USE SIGNAL ;
- internal ( E Y ) ( A A ) + USE SIGNAL ;
END NETS
END DESIGN
