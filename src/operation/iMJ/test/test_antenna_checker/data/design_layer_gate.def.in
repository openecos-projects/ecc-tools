VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN antenna_layer_gate_test ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 30000 30000 ) ;
ROW ROW_0 CORE 0 0 N DO 30 BY 1 STEP 1000 0 ;
TRACKS X 0 DO 15 STEP 2000 LAYER M2 ;
TRACKS Y 0 DO 15 STEP 2000 LAYER M1 ;
COMPONENTS 1 ;
- q GATE_Q + FIXED ( 2000 1500 ) N ;
END COMPONENTS
NETS 1 ;
- layered ( q A )
  + USE SIGNAL
  + ROUTED M1 ( 2000 2000 ) ( 10000 2000 ) ;
END NETS
END DESIGN
